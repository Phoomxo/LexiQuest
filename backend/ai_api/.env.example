# LexiQuest AI API example environment configuration.
# Copy this file to `.env` and adjust values as needed.
#
# NOTE: Never commit your real .env, service-account JSON, or LLM API keys.
# The .env file lives in backend/ai_api/.env and is git-ignored.

# --- Service identity ---
LEXIQUEST_AI_MODEL_VERSION=0.1.0
LEXIQUEST_AI_MAX_TEXT_LENGTH=500
LEXIQUEST_AI_REQUEST_TIMEOUT_SECONDS=20

# --- Response cache (the primary cost-control mechanism) ---
# Time-to-live for cached generated content, in seconds. Default: 7 days.
LEXIQUEST_AI_CACHE_TTL_SECONDS=604800
# Maximum number of cached responses retained in memory (LRU eviction).
LEXIQUEST_AI_CACHE_MAX_ENTRIES=4096

# =============================================================================
# PROVIDER STRATEGY (resilience-first)
# -----------------------------------------------------------------------------
# PRIMARY = Ollama self-hosted on the workstation. Cost = 0 forever, immune to
#           external API outages/billing. This is the default so the thesis
#           demonstration never depends on a third-party service being up.
# FALLBACK = Gemini OpenAI-compat (free tier). Used automatically when the
#            primary is unreachable or returns a hard error.
#
# Both providers speak the OpenAI-compatible /chat/completions contract, so
# switching is purely a configuration change (no code change).
# =============================================================================

# --- Primary provider: Ollama (local) ---
# Install Ollama (https://ollama.com) then:  ollama pull qwen2.5:3b
LEXIQUEST_AI_LLM_PROVIDER=openai-compat
LEXIQUEST_AI_LLM_MODEL=qwen2.5:3b
LEXIQUEST_AI_LLM_BASE_URL=http://127.0.0.1:11434/v1/
# Ollama ignores the key but the OpenAI-compat contract requires a non-empty
# Authorization header, so any placeholder works.
LEXIQUEST_AI_LLM_API_KEY=ollama

# --- Fallback provider: Gemini OpenAI-compat (free tier) ---
# Activated automatically when the primary is unavailable. Sign up at
# https://aistudio.google.com/apikey to get a free key (1,500 req/day).
# Leave FALLBACK_* empty to disable the fallback chain entirely.
LEXIQUEST_AI_FALLBACK_LLM_MODEL=gemini-2.0-flash
LEXIQUEST_AI_FALLBACK_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LEXIQUEST_AI_FALLBACK_LLM_API_KEY=

# --- Optional: additional Gemini keys for round-robin load distribution ---
# Comma-separated. Each key gets its own 1,500/day quota, so N keys multiply
# the daily ceiling N-fold. Useful for the 150-student trial.
# Example: LEXIQUEST_AI_GEMINI_KEYS=key-aaa,key-bbb,key-ccc
LEXIQUEST_AI_GEMINI_KEYS=

# --- Rate limiting (protects every provider in the chain) ---
# Max requests per minute to a single provider endpoint. Defaults match the
# Gemini free tier (15 RPM). Set higher for a local Ollama that can take more.
LEXIQUEST_AI_PROVIDER_RPM_LIMIT=15

# --- Decoding parameters ---
LEXIQUEST_AI_LLM_TEMPERATURE=0.4
LEXIQUEST_AI_LLM_MAX_TOKENS=512
