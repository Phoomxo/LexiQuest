# LexiQuest Voice API example environment configuration.
# Copy this file to `.env` and adjust values as needed.

LEXIQUEST_VOICE_MODEL_ID=k2-fsa/OmniVoice
LEXIQUEST_VOICE_MODEL_VERSION=0.2.1
LEXIQUEST_VOICE_MODEL_REVISION=c5fdb5ccb189668d56333f77ba2629f4cd7535f4
LEXIQUEST_VOICE_DEVICE=cuda:0
LEXIQUEST_VOICE_VOICE_INSTRUCTION=female, young adult, clear teacher voice
LEXIQUEST_VOICE_SAMPLE_RATE=24000
LEXIQUEST_VOICE_MAX_TEXT_LENGTH=500
LEXIQUEST_VOICE_GENERATION_TIMEOUT_SECONDS=30
LEXIQUEST_VOICE_GENERATION_NUM_STEPS=32
LEXIQUEST_VOICE_GUIDANCE_SCALE=2.0
LEXIQUEST_VOICE_POSITION_TEMPERATURE=0.0
LEXIQUEST_VOICE_CLASS_TEMPERATURE=0.0
LEXIQUEST_VOICE_LOAD_ASR=false
