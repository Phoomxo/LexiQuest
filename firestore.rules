rules_version = '2';

// =============================================================================
// LexiQuest Firestore Security Rules
// -----------------------------------------------------------------------------
// Least-privilege, default-deny rules covering ONLY the collections evidenced
// by the Flutter client under lib/ and the lib/add_default_categories.js
// maintainer seed. The maintainer seed runs through the Firebase Admin SDK,
// which bypasses these rules entirely, so it is intentionally granted no
// client path here.
//
// Posture
//   * Every client grant requires a signed-in user (request.auth.uid != null).
//   * Per-user collections (users, state, categories, categories/.../words,
//     purchased_items) enforce self-ownership via the Firebase Auth uid.
//   * Shared/catalog/telemetry collections that carry no owner uid
//     (products, global_words, vocabulary, quiz, voice_telemetry_events) use
//     the strongest safe alternative (read-only, or create-only) and are
//     documented inline.
//   * The trailing match /{document=**} denies everything else, including any
//     collection not yet authored here.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth.uid != null;
    }

    function isRegisteredUser() {
      return isSignedIn()
        && (!('firebase' in request.auth.token)
            || !('sign_in_provider' in request.auth.token.firebase)
            || request.auth.token.firebase.sign_in_provider != 'anonymous');
    }

    function ownsFieldUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function fieldEntityEnvelopeOk(entityId) {
      return request.resource.data is map
        && request.resource.data.keys().hasOnly([
             'schemaVersion', 'entityId', 'payload', 'revision', 'isDeleted',
             'clientUpdatedAtUtcMs', 'serverUpdatedAt', 'lastOperationId'
           ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.entityId == entityId
        && request.resource.data.entityId is string
        && request.resource.data.entityId.size() > 0
        && request.resource.data.entityId.size() <= 256
        && request.resource.data.payload is map
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.isDeleted is bool
        && request.resource.data.clientUpdatedAtUtcMs is int
        && request.resource.data.clientUpdatedAtUtcMs >= 0
        && request.resource.data.serverUpdatedAt == request.time
        && request.resource.data.lastOperationId is string
        && request.resource.data.lastOperationId.size() > 0
        && request.resource.data.lastOperationId.size() <= 256;
    }

    function fieldCategoryPayloadOk() {
      let payload = request.resource.data.payload;
      return payload.keys().hasOnly([
          'name', 'normalizedName', 'sortOrder', 'isDeleted',
          'createdAtUtcMs', 'updatedAtUtcMs'
        ])
        && payload.name is string
        && payload.name.size() > 0
        && payload.name.size() <= 120
        && payload.normalizedName is string
        && payload.normalizedName.size() > 0
        && payload.normalizedName.size() <= 120
        && payload.sortOrder is int
        && payload.sortOrder >= 0
        && payload.isDeleted is bool
        && payload.isDeleted == request.resource.data.isDeleted
        && payload.createdAtUtcMs is int
        && payload.createdAtUtcMs >= 0
        && payload.updatedAtUtcMs is int
        && payload.updatedAtUtcMs >= payload.createdAtUtcMs;
    }

    function fieldWordPayloadOk() {
      let payload = request.resource.data.payload;
      return payload.keys().hasOnly([
          'categoryId', 'spelling', 'normalizedSpelling', 'meaning',
          'normalizedMeaning', 'partOfSpeech', 'cefrLevel', 'source',
          'isGlobal', 'isDeleted', 'createdAtUtcMs', 'updatedAtUtcMs'
        ])
        && payload.categoryId is string
        && payload.categoryId.size() > 0
        && payload.categoryId.size() <= 256
        && payload.spelling is string
        && payload.spelling.size() > 0
        && payload.spelling.size() <= 200
        && payload.normalizedSpelling is string
        && payload.normalizedSpelling.size() > 0
        && payload.normalizedSpelling.size() <= 200
        && payload.meaning is string
        && payload.meaning.size() > 0
        && payload.meaning.size() <= 1000
        && payload.normalizedMeaning is string
        && payload.normalizedMeaning.size() > 0
        && payload.normalizedMeaning.size() <= 1000
        && payload.partOfSpeech is string
        && payload.partOfSpeech.size() <= 60
        && (payload.cefrLevel == null
            || (payload.cefrLevel is string
                && payload.cefrLevel.size() <= 20))
        && payload.source is string
        && payload.source.size() > 0
        && payload.source.size() <= 60
        && payload.isGlobal is bool
        && payload.isDeleted is bool
        && payload.isDeleted == request.resource.data.isDeleted
        && payload.createdAtUtcMs is int
        && payload.createdAtUtcMs >= 0
        && payload.updatedAtUtcMs is int
        && payload.updatedAtUtcMs >= payload.createdAtUtcMs;
    }

    function fieldWordCategoryExists(uid) {
      return existsAfter(
        /databases/$(database)/documents/field_users/$(uid)/categories/$(request.resource.data.payload.categoryId)
      );
    }

    function fieldAttemptPayloadOk() {
      let payload = request.resource.data.payload;
      return payload.keys().hasOnly([
          'sessionId', 'wordId', 'promptMode', 'isCorrect',
          'responseTimeMs', 'attemptNumber', 'occurredAtUtcMs',
          'providerProvenance'
        ])
        && payload.sessionId is string
        && payload.sessionId.size() > 0
        && payload.sessionId.size() <= 256
        && payload.wordId is string
        && payload.wordId.size() > 0
        && payload.wordId.size() <= 256
        && payload.promptMode is string
        && payload.promptMode.size() > 0
        && payload.promptMode.size() <= 60
        && payload.isCorrect is bool
        && (payload.responseTimeMs == null
            || (payload.responseTimeMs is int
                && payload.responseTimeMs >= 0
                && payload.responseTimeMs <= 2147483647))
        && payload.attemptNumber is int
        && payload.attemptNumber > 0
        && payload.attemptNumber <= 1000000
        && payload.occurredAtUtcMs is int
        && payload.occurredAtUtcMs >= 0
        && (payload.providerProvenance == null
            || (payload.providerProvenance is string
                && payload.providerProvenance.size() <= 120))
        && request.resource.data.revision == 1
        && !request.resource.data.isDeleted;
    }

    function fieldReadingEventPayloadOk() {
      let payload = request.resource.data.payload;
      return payload.keys().hasOnly([
          'documentId', 'documentRevision', 'eventType', 'position',
          'occurredAtUtcMs'
        ])
        && payload.documentId is string
        && payload.documentId.size() > 0
        && payload.documentId.size() <= 256
        && payload.documentRevision is int
        && payload.documentRevision > 0
        && payload.eventType in ['checkpoint', 'completed']
        && (payload.position == null
            || (payload.position is int && payload.position >= 0))
        && payload.occurredAtUtcMs is int
        && payload.occurredAtUtcMs >= 0
        && request.resource.data.revision == 1
        && !request.resource.data.isDeleted;
    }

    function fieldRewardCatalogEntryOk() {
      let payload = request.resource.data.payload;
      return payload.catalogVersion == 1
        && ((payload.itemId == 'theme_default'
             && payload.slot == 'theme'
             && (payload.transactionType == 'equip'
                 || payload.amount == 0))
            || (payload.itemId == 'theme_ocean'
                && payload.slot == 'theme'
                && (payload.transactionType == 'equip'
                    || payload.amount == -80))
            || (payload.itemId == 'wallpaper_focus'
                && payload.slot == 'wallpaper'
                && (payload.transactionType == 'equip'
                    || payload.amount == -60))
            || (payload.itemId == 'headgear_ipa'
                && payload.slot == 'headgear'
                && (payload.transactionType == 'equip'
                    || payload.amount == -100))
            || (payload.itemId == 'weapon_cefr'
                && payload.slot == 'weapon'
                && (payload.transactionType == 'equip'
                    || payload.amount == -120))
            || (payload.itemId == 'armor_srs'
                && payload.slot == 'armor'
                && (payload.transactionType == 'equip'
                    || payload.amount == -120)));
    }

    function fieldRewardTransactionPayloadOk() {
      let payload = request.resource.data.payload;
      return payload.keys().hasOnly([
          'idempotencyKey', 'transactionType', 'amount', 'itemId', 'slot',
          'catalogVersion', 'sourceEventId', 'occurredAtUtcMs'
        ])
        && payload.idempotencyKey is string
        && payload.idempotencyKey.size() > 0
        && payload.idempotencyKey.size() <= 256
        && payload.transactionType in ['purchase', 'equip']
        && payload.amount is int
        && payload.itemId is string
        && payload.itemId.size() > 0
        && payload.itemId.size() <= 256
        && payload.slot is string
        && payload.slot.size() > 0
        && payload.slot.size() <= 60
        && payload.catalogVersion is int
        && (payload.sourceEventId == null
            || (payload.sourceEventId is string
                && payload.sourceEventId.size() <= 256))
        && payload.occurredAtUtcMs is int
        && payload.occurredAtUtcMs >= 0
        && (payload.transactionType != 'equip' || payload.amount == 0)
        && fieldRewardCatalogEntryOk()
        && request.resource.data.revision == 1
        && !request.resource.data.isDeleted;
    }

    function fieldOperationAfter(uid, operationId) {
      return getAfter(
        /databases/$(database)/documents/field_users/$(uid)/operations/$(operationId)
      ).data;
    }

    function fieldOperationLinksEntity(uid, entityType, entityId) {
      let operation = fieldOperationAfter(
        uid,
        request.resource.data.lastOperationId
      );
      return operation.schemaVersion == 1
        && operation.operationId == request.resource.data.lastOperationId
        && operation.entityType == entityType
        && operation.entityId == entityId
        && operation.resultingRevision == request.resource.data.revision
        && operation.baseRevision
             == (resource == null ? 0 : resource.data.revision)
        && operation.resultingRevision > operation.baseRevision
        && ((operation.operationKind == 'delete'
             && request.resource.data.isDeleted)
            || (operation.operationKind == 'upsert'
                && !request.resource.data.isDeleted));
    }

    function fieldOperationEnvelopeOk(operationId) {
      return request.resource.data is map
        && request.resource.data.keys().hasOnly([
             'schemaVersion', 'operationId', 'entityType', 'entityId',
             'operationKind', 'baseRevision', 'resultingRevision',
             'acknowledgedAt'
           ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.operationId == operationId
        && request.resource.data.operationId is string
        && request.resource.data.operationId.size() > 0
        && request.resource.data.operationId.size() <= 256
        && request.resource.data.entityType in [
             'category', 'word', 'attempt', 'readingEvent',
             'rewardTransaction'
           ]
        && request.resource.data.entityId is string
        && request.resource.data.entityId.size() > 0
        && request.resource.data.entityId.size() <= 256
        && request.resource.data.operationKind in ['upsert', 'delete']
        && request.resource.data.baseRevision is int
        && request.resource.data.baseRevision >= 0
        && request.resource.data.resultingRevision is int
        && request.resource.data.resultingRevision
             > request.resource.data.baseRevision
        && request.resource.data.acknowledgedAt == request.time;
    }

    function fieldOperationMatchesCategory(uid) {
      let entityId = request.resource.data.entityId;
      let beforePath =
        /databases/$(database)/documents/field_users/$(uid)/categories/$(entityId);
      let entity = getAfter(beforePath).data;
      return ((!exists(beforePath)
               && request.resource.data.baseRevision == 0)
              || (exists(beforePath)
                  && get(beforePath).data.revision
                     == request.resource.data.baseRevision))
        && entity.entityId == entityId
        && entity.lastOperationId == request.resource.data.operationId
        && entity.revision == request.resource.data.resultingRevision;
    }

    function fieldOperationMatchesWord(uid) {
      let entityId = request.resource.data.entityId;
      let beforePath =
        /databases/$(database)/documents/field_users/$(uid)/words/$(entityId);
      let entity = getAfter(beforePath).data;
      return ((!exists(beforePath)
               && request.resource.data.baseRevision == 0)
              || (exists(beforePath)
                  && get(beforePath).data.revision
                     == request.resource.data.baseRevision))
        && entity.entityId == entityId
        && entity.lastOperationId == request.resource.data.operationId
        && entity.revision == request.resource.data.resultingRevision;
    }

    function fieldOperationMatchesAttempt(uid) {
      let entityId = request.resource.data.entityId;
      let entityPath =
        /databases/$(database)/documents/field_users/$(uid)/attempts/$(entityId);
      let entity = getAfter(entityPath).data;
      return !exists(entityPath)
        && request.resource.data.operationKind == 'upsert'
        && request.resource.data.baseRevision == 0
        && request.resource.data.resultingRevision == 1
        && entity.entityId == entityId
        && entity.lastOperationId == request.resource.data.operationId
        && entity.revision == 1;
    }

    function fieldOperationMatchesReadingEvent(uid) {
      let entityId = request.resource.data.entityId;
      let entityPath =
        /databases/$(database)/documents/field_users/$(uid)/reading_events/$(entityId);
      let entity = getAfter(entityPath).data;
      return !exists(entityPath)
        && request.resource.data.operationKind == 'upsert'
        && request.resource.data.baseRevision == 0
        && request.resource.data.resultingRevision == 1
        && entity.entityId == entityId
        && entity.lastOperationId == request.resource.data.operationId
        && entity.revision == 1;
    }

    function fieldOperationMatchesRewardTransaction(uid) {
      let entityId = request.resource.data.entityId;
      let entityPath =
        /databases/$(database)/documents/field_users/$(uid)/reward_transactions/$(entityId);
      let entity = getAfter(entityPath).data;
      return !exists(entityPath)
        && request.resource.data.operationKind == 'upsert'
        && request.resource.data.baseRevision == 0
        && request.resource.data.resultingRevision == 1
        && entity.entityId == entityId
        && entity.lastOperationId == request.resource.data.operationId
        && entity.revision == 1;
    }

    // True when the categories/{categoryId} document is owned by the signed-in
    // user. Used to authorize the nested words subcollection, whose own
    // user_id field is unreliably populated (incl. empty strings from the
    // Datamuse path) and is therefore never used for authorization.
    function ownsCategory(database, categoryId) {
      return get(/databases/$(database)/documents/categories/$(categoryId))
              .data.uid
        == request.auth.uid;
    }

    // Strict allow-list + types for a categories/{id}/words document. The
    // redundant camelCase userId marker written by the Datamuse path is
    // tolerated in the allow-list (see accompanying explanation).
    function wordFieldsOk() {
      return request.resource.data is map
        && request.resource.data.keys().hasOnly([
             'word', 'meaning', 'part_of_speech', 'user_id', 'is_global',
             'created_at', 'userId'
           ])
        && request.resource.data.word is string
        && request.resource.data.word.size() > 0
        && request.resource.data.word.size() <= 120
        && request.resource.data.meaning is string
        && request.resource.data.meaning.size() <= 500
        && request.resource.data.part_of_speech is string
        && request.resource.data.part_of_speech.size() <= 60
        && request.resource.data.user_id is string
        && request.resource.data.is_global is bool
        && request.resource.data.created_at is timestamp
        && (!('userId' in request.resource.data.keys())
             || request.resource.data.userId is string);
    }

    // Strict allow-list + types for a voice_telemetry_events document (the
    // VoiceTelemetryEvent privacy-safe field set).
    function voiceTelemetryFieldsOk() {
      return request.resource.data is map
        && request.resource.data.keys().hasOnly([
             'schemaVersion', 'outcome', 'mode', 'requestedEngine',
             'actualEngine', 'usedFallback', 'fallbackReason',
             'failureCategory', 'cacheHit', 'latencyMs', 'contentId',
             'contentType', 'requestId', 'modelVersion', 'occurredAtUtc'
           ])
        && request.resource.data.schemaVersion is string
        && request.resource.data.outcome is string
        && request.resource.data.mode is string
        && request.resource.data.requestedEngine is string
        && (!('actualEngine' in request.resource.data.keys())
             || request.resource.data.actualEngine is string
             || request.resource.data.actualEngine == null)
        && request.resource.data.usedFallback is bool
        && (!('fallbackReason' in request.resource.data.keys())
             || request.resource.data.fallbackReason is string
             || request.resource.data.fallbackReason == null)
        && (!('failureCategory' in request.resource.data.keys())
             || request.resource.data.failureCategory is string
             || request.resource.data.failureCategory == null)
        && request.resource.data.cacheHit is bool
        && request.resource.data.latencyMs is int
        && request.resource.data.latencyMs >= 0
        && request.resource.data.latencyMs <= 86400000
        && request.resource.data.contentId is string
        && request.resource.data.contentId.size() <= 200
        && request.resource.data.contentType is string
        && request.resource.data.contentType.size() <= 60
        && (!('requestId' in request.resource.data.keys())
             || request.resource.data.requestId is string
             || request.resource.data.requestId == null)
        && (!('modelVersion' in request.resource.data.keys())
             || request.resource.data.modelVersion is string
             || request.resource.data.modelVersion == null)
        && request.resource.data.occurredAtUtc is string
        && request.resource.data.occurredAtUtc.size() <= 40;
    }

    // A purchase record may only be created by the same atomic write that
    // debits the buyer's points by the exact positive catalog price.
    function purchaseIntegrityOk(database) {
      let productDoc = get(
        /databases/$(database)/documents/products/$(request.resource.data.product_id)
      );
      let stateDoc = get(
        /databases/$(database)/documents/state/$(request.auth.uid)
      );
      let stateAfterDoc = getAfter(
        /databases/$(database)/documents/state/$(request.auth.uid)
      );
      return exists(
          /databases/$(database)/documents/products/$(request.resource.data.product_id)
        )
        && productDoc.data.price is int
        && productDoc.data.price > 0
        && request.resource.data.total_price == productDoc.data.price
        && exists(
          /databases/$(database)/documents/state/$(request.auth.uid)
        )
        && stateDoc.data.totalPoints is int
        && stateDoc.data.totalPoints >= request.resource.data.total_price
        && stateAfterDoc.data.totalPoints is int
        && stateAfterDoc.data.totalPoints
             == stateDoc.data.totalPoints
                - request.resource.data.total_price;
    }

    // -------------------------------------------------------------------------
    // field_users/{uid} - versioned local-first sync mirror. The owner path is
    // the authorization boundary. Entity and immutable operation writes must
    // be committed atomically and must agree on the exact base/result revision.
    // -------------------------------------------------------------------------
    match /field_users/{uid} {
      allow read, write: if false;

      match /categories/{categoryId} {
        allow read: if ownsFieldUser(uid);
        allow create, update: if ownsFieldUser(uid)
          && fieldEntityEnvelopeOk(categoryId)
          && fieldCategoryPayloadOk()
          && fieldOperationLinksEntity(uid, 'category', categoryId);
        allow delete: if false;
      }

      match /words/{wordId} {
        allow read: if ownsFieldUser(uid);
        allow create, update: if ownsFieldUser(uid)
          && fieldEntityEnvelopeOk(wordId)
          && fieldWordPayloadOk()
          && fieldWordCategoryExists(uid)
          && fieldOperationLinksEntity(uid, 'word', wordId);
        allow delete: if false;
      }

      match /attempts/{attemptId} {
        allow read: if ownsFieldUser(uid);
        allow create: if ownsFieldUser(uid)
          && fieldEntityEnvelopeOk(attemptId)
          && fieldAttemptPayloadOk()
          && fieldOperationLinksEntity(uid, 'attempt', attemptId);
        allow update, delete: if false;
      }

      match /reading_events/{eventId} {
        allow read: if ownsFieldUser(uid);
        allow create: if ownsFieldUser(uid)
          && fieldEntityEnvelopeOk(eventId)
          && fieldReadingEventPayloadOk()
          && fieldOperationLinksEntity(uid, 'readingEvent', eventId);
        allow update, delete: if false;
      }

      match /reward_transactions/{transactionId} {
        allow read: if ownsFieldUser(uid);
        allow create: if ownsFieldUser(uid)
          && fieldEntityEnvelopeOk(transactionId)
          && fieldRewardTransactionPayloadOk()
          && fieldOperationLinksEntity(
               uid,
               'rewardTransaction',
               transactionId
             );
        allow update, delete: if false;
      }

      match /operations/{operationId} {
        allow read: if ownsFieldUser(uid);
        allow create: if ownsFieldUser(uid)
          && fieldOperationEnvelopeOk(operationId)
          && ((request.resource.data.entityType == 'category'
               && fieldOperationMatchesCategory(uid))
              || (request.resource.data.entityType == 'word'
                  && fieldOperationMatchesWord(uid))
              || (request.resource.data.entityType == 'attempt'
                  && fieldOperationMatchesAttempt(uid))
              || (request.resource.data.entityType == 'readingEvent'
                  && fieldOperationMatchesReadingEvent(uid))
              || (request.resource.data.entityType == 'rewardTransaction'
                  && fieldOperationMatchesRewardTransaction(uid)));
        allow update, delete: if false;
      }
    }

    match /app_control/field {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // users/{uid} - profile + per-user points. Keyed by uid; self only.
    //   create: AuthService.registerUser (first_name, last_name, email, age,
    //           createdAt via serverTimestamp)
    //   update: QuizScreen._savePointsToFirestore (merge totalPoints/gamesPlayed)
    //   read  : SettingScreen, UserService.getUserData
    //   createdAt is server-controlled and immutable after creation.
    // -------------------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data is map
        && request.resource.data.keys().hasOnly([
             'first_name', 'last_name', 'email', 'age', 'createdAt'
           ])
        && request.resource.data.first_name is string
        && request.resource.data.first_name.size() > 0
        && request.resource.data.first_name.size() <= 100
        && request.resource.data.last_name is string
        && request.resource.data.last_name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.age is int
        && request.resource.data.age >= 0
        && request.resource.data.age <= 150
        && request.resource.data.createdAt == request.time;

      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data is map
        && request.resource.data.keys().hasOnly([
             'first_name', 'last_name', 'email', 'age', 'points',
             'totalPoints', 'gamesPlayed', 'createdAt'
           ])
        && request.resource.data.createdAt == resource.data.createdAt
        && (!('first_name' in request.resource.data.keys())
             || (request.resource.data.first_name is string
                 && request.resource.data.first_name.size() <= 100))
        && (!('last_name' in request.resource.data.keys())
             || (request.resource.data.last_name is string
                 && request.resource.data.last_name.size() <= 100))
        && (!('email' in request.resource.data.keys())
             || (request.resource.data.email is string
                 && request.resource.data.email.size() <= 254))
        && (!('age' in request.resource.data.keys())
             || (request.resource.data.age is int
                 && request.resource.data.age >= 0
                 && request.resource.data.age <= 150))
        && (!('points' in request.resource.data.keys())
             || (request.resource.data.points is int
                 && request.resource.data.points >= 0
                 && request.resource.data.points <= 100000000))
        && (!('totalPoints' in request.resource.data.keys())
             || (request.resource.data.totalPoints is int
                 && request.resource.data.totalPoints >= -100000000
                 && request.resource.data.totalPoints <= 100000000))
        && (!('gamesPlayed' in request.resource.data.keys())
             || (request.resource.data.gamesPlayed is int
                 && request.resource.data.gamesPlayed >= 0
                 && request.resource.data.gamesPlayed <= 100000000));

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // state/{uid} - per-user game stats + selected wallpaper. Keyed by uid.
    //   create/update: ScoreScreen (merge increments), ShopPage transaction
    //                  (totalPoints increment), SelectWallpaperScreen
    //                  (selectedWallpaper update)
    //   read         : ScoreScreen, QuizScreen, ShopPage, UserService
    //   NOTE: totalPoints is client-incrementable; tamper-proof scoring needs a
    //   server-side writer (Cloud Function/Callable). See explanation.
    // -------------------------------------------------------------------------
    match /state/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;

      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data is map
        && request.resource.data.keys().hasOnly([
             'totalPoints', 'totalCorrectAnswers', 'totalWrongAnswers',
             'gamesPlayed', 'selectedWallpaper'
           ])
        && (!('totalPoints' in request.resource.data.keys())
             || (request.resource.data.totalPoints is int
                 && request.resource.data.totalPoints >= -100000000
                 && request.resource.data.totalPoints <= 100000000))
        && (!('totalCorrectAnswers' in request.resource.data.keys())
             || (request.resource.data.totalCorrectAnswers is int
                 && request.resource.data.totalCorrectAnswers >= 0
                 && request.resource.data.totalCorrectAnswers <= 100000000))
        && (!('totalWrongAnswers' in request.resource.data.keys())
             || (request.resource.data.totalWrongAnswers is int
                 && request.resource.data.totalWrongAnswers >= 0
                 && request.resource.data.totalWrongAnswers <= 100000000))
        && (!('gamesPlayed' in request.resource.data.keys())
             || (request.resource.data.gamesPlayed is int
                 && request.resource.data.gamesPlayed >= 0
                 && request.resource.data.gamesPlayed <= 100000000))
        && (!('selectedWallpaper' in request.resource.data.keys())
             || request.resource.data.selectedWallpaper is string
             || request.resource.data.selectedWallpaper == null);

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // categories/{categoryId} - user-owned vocabulary groups.
    //   create: CategoryService.addCategory / addCategoryForUser /
    //           addDefaultCategoriesForNewUser (uid == current user)
    //   read  : CategoryService.getCategoriesStream, SelectCategoryForQuiz
    //           (both filter .where('uid', '==', currentUser.uid))
    //   delete: CategoryService.deleteCategory
    //   No update path is evidenced; updates are denied.
    // -------------------------------------------------------------------------
    match /categories/{categoryId} {
      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data is map
        && request.resource.data.keys().hasOnly(['category_name', 'created_at', 'uid'])
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.category_name is string
        && request.resource.data.category_name.size() > 0
        && request.resource.data.category_name.size() <= 120
        && request.resource.data.created_at is timestamp;

      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      allow update: if false;

      // -----------------------------------------------------------------------
      // categories/{categoryId}/words/{wordId}
      //   Authorization derives from the PARENT category's uid (see
      //   ownsCategory). create/update: CategoryService.addWord,
      //   WordService.addWord*/updateWord (preserves created_at).
      //   read/delete: WordService, VocabService, CategoriesPage.
      //   Per-category size is capped at 50 by WordService on the client.
      // -----------------------------------------------------------------------
      match /words/{wordId} {
        allow read: if isSignedIn()
          && ownsCategory(database, categoryId);

        allow create: if isSignedIn()
          && ownsCategory(database, categoryId)
          && wordFieldsOk();

        allow update: if isSignedIn()
          && ownsCategory(database, categoryId)
          && wordFieldsOk()
          && request.resource.data.created_at == resource.data.created_at;

        allow delete: if isSignedIn()
          && ownsCategory(database, categoryId);
      }
    }

    // -------------------------------------------------------------------------
    // vocabulary/{vocabId} - SHARED, uid-less A1 pool (default-quiz source).
    //   main_vocabulary seeds entries WITHOUT a uid; the default-quiz reads in
    //   ChooseModeScreen/QuizService list the whole pool. True uid ownership is
    //   impossible here, so the pool is read for signed-in users and append-
    //   only with strict fields. update/delete are denied. See explanation.
    // -------------------------------------------------------------------------
    match /vocabulary/{vocabId} {
      allow read: if isSignedIn();

      allow create: if isRegisteredUser()
        && request.resource.data is map
        && request.resource.data.keys().hasOnly(['word', 'meaning', 'part_of_speech', 'uid'])
        && request.resource.data.word is string
        && request.resource.data.word.size() > 0
        && request.resource.data.word.size() <= 120
        && request.resource.data.meaning is string
        && request.resource.data.meaning.size() <= 500
        && request.resource.data.part_of_speech is string
        && request.resource.data.part_of_speech.size() <= 60
        && (!('uid' in request.resource.data.keys())
             || request.resource.data.uid is string);

      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // global_words/{word} - shared, write-once dictionary cache keyed by word.
    //   GlobalWordService.addWordToDatabase only writes after a cache miss, so
    //   the evidenced path is create-only. createdAt is server-controlled.
    // -------------------------------------------------------------------------
    match /global_words/{word} {
      allow read: if isSignedIn();

      allow create: if isRegisteredUser()
        && request.resource.data is map
        && request.resource.data.keys().hasOnly(['word', 'meaning', 'partOfSpeech', 'createdAt'])
        && request.resource.data.word is string
        && request.resource.data.word.size() > 0
        && request.resource.data.word.size() <= 120
        && request.resource.data.meaning is string
        && request.resource.data.meaning.size() <= 1000
        && request.resource.data.partOfSpeech is string
        && request.resource.data.partOfSpeech.size() <= 60
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // products/{productId} - shop catalog (prices, image refs).
    //   Clients only READ. The client-side seeding in ShopPage._seedDefault
    //   Products and the in-app "restore" button are DENIED on purpose: a price
    //   catalog must not be client-writable. The shop falls back to its
    //   in-memory defaults when persistence is denied. Seeding belongs to Admin.
    // -------------------------------------------------------------------------
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // purchased_items/{purchaseId} - per-user ownership records.
    //   create: ShopPage._buyProduct transaction (user_id == current user)
    //   read  : ShopPage, SelectWallpaperScreen (both filter .where('user_id'))
    // -------------------------------------------------------------------------
    match /purchased_items/{purchaseId} {
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;

      allow create: if isRegisteredUser()
        && request.resource.data is map
        && request.resource.data.keys().hasOnly(['user_id', 'product_id', 'total_price', 'created_at'])
        && request.resource.data.user_id is string
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.product_id is string
        && request.resource.data.product_id.size() > 0
        && request.resource.data.product_id.size() <= 120
        && request.resource.data.total_price is int
        && request.resource.data.total_price > 0
        && request.resource.data.total_price <= 100000000
        && request.resource.data.created_at is timestamp
        && purchaseIntegrityOk(database);

      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // quiz/{quizId} - DENIED. QuizService is the only writer and is never
    // instantiated in the app (dead code), the documents carry no uid, and no
    // reader exists. Do not enable until ownership and a reader are designed.
    // -------------------------------------------------------------------------
    match /quiz/{quizId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // voice_telemetry_events/{eventId} - privacy-safe, uid-less telemetry.
    //   create-only with the VoiceTelemetryEvent allow-list; reads/updates/
    //   deletes are denied so the client never exfiltrates accumulated events.
    //   See explanation re: adding a server-stamped uid.
    // -------------------------------------------------------------------------
    match /voice_telemetry_events/{eventId} {
      allow create: if isRegisteredUser() && voiceTelemetryFieldsOk();
      allow read, update, delete: if false;
    }

    // ---- default deny -------------------------------------------------------
    // Anything not explicitly matched above is denied. This also closes any
    // collection introduced in the future until a tested rule is authored.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
