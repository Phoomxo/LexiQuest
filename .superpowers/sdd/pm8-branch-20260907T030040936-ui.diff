+    await tester.pumpWidget(
+      pairBoardTestApp(
+        model: pairBoardTestModel(state: state),
+        size: _phone,
+        themeMode: ThemeMode.dark,
+        highContrast: true,
+      ),
+    );
+    await _expectGolden(tester, 'thai_dark_high_contrast_wrong_repair.png');
