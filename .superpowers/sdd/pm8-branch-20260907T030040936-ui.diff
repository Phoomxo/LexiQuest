+
+      await tester.pumpWidget(app());
+      expect(find.text('เลือกคำ'), findsOneWidget);
+      final sourceId = state.orderFor(PairTileSide.prompt).first;
+      await tester.tap(
+        find.byKey(ValueKey<String>('pair-tile:prompt:$sourceId')),
