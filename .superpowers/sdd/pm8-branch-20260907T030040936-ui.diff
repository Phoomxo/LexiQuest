+
+  bool _sameTile(PairTile? a, PairTile b) =>
+      a != null && a.side == b.side && a.wordId == b.wordId;
+
+  PairLexicalItem _item(String wordId) => _state.plan.orderedLexicalItems
+      .singleWhere((item) => item.wordId == wordId);
