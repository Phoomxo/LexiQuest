+      sessionPurposeReader: h.real,
+    ),
+    composer: PairMatchingSourceComposer(allowlist: allowlist),
+    start: PairMatchingAtomicStartAdapter(
+      repository: h.real,
+      capability: InternalPairMatchingCapability(
+        allowlist: allowlist,
+        isEnabled: () => false,
+      ),
+    ),
+    protocols: protocols ?? _OwnerProtocols(),
+    canStart: () => false,
+    monotonicMicros: () => 0,
+  );
