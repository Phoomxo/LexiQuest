+    sessionId: h.operation.plan.learningSessionId,
+    roundOrdinal: c.state.roundOrdinal,
+    expectedRevision: c.state.operationRevision,
+    tile: PairTile(side, word),
+    responseTimeMs: 25,
+  ),
+);
