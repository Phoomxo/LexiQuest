diff --git a/test/navigation/account_link_coordinator_test.dart b/test/navigation/account_link_coordinator_test.dart
new file mode 100644
index 0000000..e7bb8ea
--- /dev/null
+++ b/test/navigation/account_link_coordinator_test.dart
@@ -0,0 +1,79 @@
+import 'dart:async';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:vocab_learning_app/navigation/account_link_coordinator.dart';
+import 'package:vocab_learning_app/navigation/app_route.dart';
+
+void main() {
+  final resetLink = Uri.parse(
+    'https://vocab-learning-app-219ef.web.app/auth/action?mode=resetPassword&oobCode=reset-code',
+  );
+  final verifyLink = Uri.parse(
+    'https://vocab-learning-app-219ef.web.app/auth/action?mode=verifyEmail&oobCode=verify-code',
+  );
+
+  test('cold reset action link navigates to the typed reset route', () async {
+    final navigations = <({AppRoute route, Object? arguments})>[];
+    final coordinator = AccountLinkCoordinator.forTesting(
+      initialLink: Future<Uri?>.value(resetLink),
+      uriLinks: const Stream<Uri>.empty(),
+      navigate: (route, arguments) =>
+          navigations.add((route: route, arguments: arguments)),
+    );
+
+    await coordinator.start();
+
+    expect(navigations, hasLength(1));
+    expect(navigations.single.route, AppRoute.resetPassword);
+    expect(navigations.single.arguments, isA<ResetPasswordRouteArgs>());
+    expect(
+      (navigations.single.arguments! as ResetPasswordRouteArgs).code,
+      'reset-code',
+    );
+  });
+
+  test(
+    'warm verification action link navigates to the typed verification route',
+    () async {
+      final controller = StreamController<Uri>();
+      final navigations = <({AppRoute route, Object? arguments})>[];
+      final coordinator = AccountLinkCoordinator.forTesting(
+        initialLink: Future<Uri?>.value(null),
+        uriLinks: controller.stream,
+        navigate: (route, arguments) =>
+            navigations.add((route: route, arguments: arguments)),
+      );
+      await coordinator.start();
+      controller.add(verifyLink);
+      await Future<void>.delayed(Duration.zero);
+
+      expect(navigations, hasLength(1));
+      expect(navigations.single.route, AppRoute.verifyEmail);
+      expect(navigations.single.arguments, isA<VerifyEmailActionRouteArgs>());
+      expect(
+        (navigations.single.arguments! as VerifyEmailActionRouteArgs).code,
+        'verify-code',
+      );
+      await controller.close();
+      coordinator.dispose();
+    },
+  );
+
+  test('foreign and malformed links are ignored without navigation', () async {
+    final navigations = <({AppRoute route, Object? arguments})>[];
+    final coordinator = AccountLinkCoordinator.forTesting(
+      initialLink: Future<Uri?>.value(
+        Uri.parse(
+          'https://evil.example/auth/action?mode=resetPassword&oobCode=secret',
+        ),
+      ),
+      uriLinks: const Stream<Uri>.empty(),
+      navigate: (route, arguments) =>
+          navigations.add((route: route, arguments: arguments)),
+    );
+
+    await coordinator.start();
+
+    expect(navigations, isEmpty);
+  });
+}
diff --git a/test/screens/forgot_password_screen_test.dart b/test/screens/forgot_password_screen_test.dart
new file mode 100644
index 0000000..a8e0aa4
--- /dev/null
+++ b/test/screens/forgot_password_screen_test.dart
@@ -0,0 +1,138 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:vocab_learning_app/account/account_cooldown.dart';
+import 'package:vocab_learning_app/account/account_error_mapper.dart';
+import 'package:vocab_learning_app/account/account_gateway.dart';
+import 'package:vocab_learning_app/account/account_models.dart';
+import 'package:vocab_learning_app/screens/forgot_password_screen.dart';
+
+final class _FakeAccountGateway implements AccountGateway {
+  _FakeAccountGateway({this.resetError});
+
+  final Object? resetError;
+  final List<String> resetRequests = <String>[];
+
+  @override
+  AccountSession? get currentSession => null;
+  @override
+  Stream<AccountSession?> authStateChanges() => const Stream.empty();
+  @override
+  Future<void> applyVerificationCode(String code) => throw UnimplementedError();
+  @override
+  Future<void> changePassword({
+    required String currentPassword,
+    required String newPassword,
+  }) => throw UnimplementedError();
+  @override
+  Future<void> confirmPasswordReset({
+    required String code,
+    required String newPassword,
+  }) => throw UnimplementedError();
+  @override
+  Future<AccountSession> createAccount({
+    required String email,
+    required String password,
+  }) => throw UnimplementedError();
+  @override
+  Future<void> requestPasswordReset(String email) async {
+    resetRequests.add(email);
+    final error = resetError;
+    if (error != null) throw error;
+  }
+
+  @override
+  Future<AccountSession?> reloadSession() => throw UnimplementedError();
+  @override
+  Future<void> sendVerificationEmail() => throw UnimplementedError();
+  @override
+  Future<AccountSession> signIn({
+    required String email,
+    required String password,
+  }) => throw UnimplementedError();
+  @override
+  Future<void> signOut() => throw UnimplementedError();
+  @override
+  Future<GuestUpgradeResult> upgradeAnonymous({
+    required String email,
+    required String password,
+  }) => throw UnimplementedError();
+  @override
+  Future<String> verifyPasswordResetCode(String code) =>
+      throw UnimplementedError();
+}
+
+Widget _subject(_FakeAccountGateway gateway) => MaterialApp(
+  home: ForgotPasswordScreen(
+    accountGateway: gateway,
+    cooldown: AccountCooldown(duration: Duration.zero),
+  ),
+);
+
+Future<void> _submit(WidgetTester tester, String email) async {
+  await tester.enterText(
+    find.byKey(const ValueKey<String>('recovery-email')),
+    email,
+  );
+  await tester.tap(find.byKey(const ValueKey<String>('recovery-submit')));
+  await tester.pump();
+}
+
+void main() {
+  for (final error in <Object?>[
+    null,
+    const AccountOperationException('user-not-found'),
+    const AccountOperationException('email-not-found'),
+  ]) {
+    testWidgets(
+      'shows neutral acknowledgement for accepted and non-existent accounts',
+      (tester) async {
+        final gateway = _FakeAccountGateway(resetError: error);
+        await tester.pumpWidget(_subject(gateway));
+
+        await _submit(tester, ' Student@Example.com ');
+
+        expect(gateway.resetRequests, equals(<String>['student@example.com']));
+        expect(
+          find.text(AccountErrorMapper.recoveryAcceptedMessage),
+          findsOneWidget,
+        );
+      },
+    );
+  }
+
+  testWidgets('rejects an invalid local email before calling the gateway', (
+    tester,
+  ) async {
+    final gateway = _FakeAccountGateway();
+    await tester.pumpWidget(_subject(gateway));
+
+    await _submit(tester, 'not-an-email');
+
+    expect(gateway.resetRequests, isEmpty);
+  });
+
+  testWidgets(
+    'shows a network failure instead of an accepted acknowledgement',
+    (tester) async {
+      final gateway = _FakeAccountGateway(
+        resetError: const AccountOperationException('network-request-failed'),
+      );
+      await tester.pumpWidget(_subject(gateway));
+
+      await _submit(tester, 'student@example.com');
+
+      expect(
+        find.text(AccountErrorMapper.recoveryAcceptedMessage),
+        findsNothing,
+      );
+      expect(
+        find.text(AccountErrorMapper.messageFor('network-request-failed')),
+        findsOneWidget,
+      );
+      expect(
+        find.byKey(const ValueKey<String>('recovery-retry')),
+        findsOneWidget,
+      );
+    },
+  );
+}
diff --git a/test/screens/reset_password_screen_test.dart b/test/screens/reset_password_screen_test.dart
new file mode 100644
index 0000000..59bdaff
--- /dev/null
+++ b/test/screens/reset_password_screen_test.dart
@@ -0,0 +1,178 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:vocab_learning_app/account/account_gateway.dart';
+import 'package:vocab_learning_app/account/account_models.dart';
+import 'package:vocab_learning_app/navigation/app_route.dart';
+import 'package:vocab_learning_app/screens/reset_password_screen.dart';
+
+final class _FakeAccountGateway implements AccountGateway {
+  _FakeAccountGateway({this.verifyError});
+
+  final Object? verifyError;
+  final List<String> verifiedCodes = <String>[];
+  final List<({String code, String password})> confirmedResets =
+      <({String code, String password})>[];
+
+  @override
+  AccountSession? get currentSession => null;
+  @override
+  Stream<AccountSession?> authStateChanges() => const Stream.empty();
+  @override
+  Future<void> applyVerificationCode(String code) => throw UnimplementedError();
+  @override
+  Future<void> changePassword({
+    required String currentPassword,
+    required String newPassword,
+  }) => throw UnimplementedError();
+  @override
+  Future<void> confirmPasswordReset({
+    required String code,
+    required String newPassword,
+  }) async {
+    confirmedResets.add((code: code, password: newPassword));
+  }
+
+  @override
+  Future<AccountSession> createAccount({
+    required String email,
+    required String password,
+  }) => throw UnimplementedError();
+  @override
+  Future<void> requestPasswordReset(String email) => throw UnimplementedError();
+  @override
+  Future<AccountSession?> reloadSession() => throw UnimplementedError();
+  @override
+  Future<void> sendVerificationEmail() => throw UnimplementedError();
+  @override
+  Future<AccountSession> signIn({
+    required String email,
+    required String password,
+  }) => throw UnimplementedError();
+  @override
+  Future<void> signOut() => throw UnimplementedError();
+  @override
+  Future<GuestUpgradeResult> upgradeAnonymous({
+    required String email,
+    required String password,
+  }) => throw UnimplementedError();
+  @override
+  Future<String> verifyPasswordResetCode(String code) async {
+    verifiedCodes.add(code);
+    final error = verifyError;
+    if (error != null) throw error;
+    return 'student@example.com';
+  }
+}
+
+Widget _subject(_FakeAccountGateway gateway) => MaterialApp(
+  onGenerateRoute: (settings) => MaterialPageRoute<void>(
+    settings: settings,
+    builder: (_) => settings.name == AppRoute.login.path
+        ? const Scaffold(body: Text('LOGIN_REACHED'))
+        : ResetPasswordScreen(accountGateway: gateway, code: 'one-time-code'),
+  ),
+  home: ResetPasswordScreen(accountGateway: gateway, code: 'one-time-code'),
+);
+
+void main() {
+  testWidgets('verifies the reset code before enabling password submission', (
+    tester,
+  ) async {
+    final gateway = _FakeAccountGateway();
+    await tester.pumpWidget(_subject(gateway));
+
+    expect(
+      tester
+          .widget<FilledButton>(
+            find.byKey(const ValueKey<String>('reset-submit')),
+          )
+          .onPressed,
+      isNull,
+    );
+    await tester.pumpAndSettle();
+
+    expect(gateway.verifiedCodes, equals(<String>['one-time-code']));
+    expect(
+      tester
+          .widget<FilledButton>(
+            find.byKey(const ValueKey<String>('reset-submit')),
+          )
+          .onPressed,
+      isNotNull,
+    );
+  });
+
+  testWidgets(
+    'enforces password policy and confirmation before confirming reset',
+    (tester) async {
+      final gateway = _FakeAccountGateway();
+      await tester.pumpWidget(_subject(gateway));
+      await tester.pumpAndSettle();
+
+      await tester.enterText(
+        find.byKey(const ValueKey<String>('reset-password')),
+        'short',
+      );
+      await tester.enterText(
+        find.byKey(const ValueKey<String>('reset-confirmation')),
+        'short',
+      );
+      await tester.tap(find.byKey(const ValueKey<String>('reset-submit')));
+      await tester.pump();
+      expect(gateway.confirmedResets, isEmpty);
+
+      await tester.enterText(
+        find.byKey(const ValueKey<String>('reset-password')),
+        'Password1',
+      );
+      await tester.enterText(
+        find.byKey(const ValueKey<String>('reset-confirmation')),
+        'Different1',
+      );
+      await tester.tap(find.byKey(const ValueKey<String>('reset-submit')));
+      await tester.pump();
+      expect(gateway.confirmedResets, isEmpty);
+    },
+  );
+
+  testWidgets('confirms exactly once and routes to login', (tester) async {
+    final gateway = _FakeAccountGateway();
+    await tester.pumpWidget(_subject(gateway));
+    await tester.pumpAndSettle();
+
+    await tester.enterText(
+      find.byKey(const ValueKey<String>('reset-password')),
+      'Password1',
+    );
+    await tester.enterText(
+      find.byKey(const ValueKey<String>('reset-confirmation')),
+      'Password1',
+    );
+    await tester.tap(find.byKey(const ValueKey<String>('reset-submit')));
+    await tester.pumpAndSettle();
+
+    expect(
+      gateway.confirmedResets,
+      equals(<({String code, String password})>[
+        (code: 'one-time-code', password: 'Password1'),
+      ]),
+    );
+    expect(find.text('LOGIN_REACHED'), findsOneWidget);
+  });
+
+  testWidgets(
+    'offers to request a new link for expired or invalid reset codes',
+    (tester) async {
+      final gateway = _FakeAccountGateway(
+        verifyError: const AccountOperationException('expired-action-code'),
+      );
+      await tester.pumpWidget(_subject(gateway));
+      await tester.pumpAndSettle();
+
+      expect(
+        find.byKey(const ValueKey<String>('reset-request-new-link')),
+        findsOneWidget,
+      );
+    },
+  );
+}
