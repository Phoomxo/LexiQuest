+      PairConfirmGuidedMapping confirm({String? owner, int responseMs = 25}) =>
+          PairConfirmGuidedMapping(
+            operationId: '1:pm8-guided',
+            ownerId: owner ?? h.operation.plan.ownerId,
+            sessionId: h.operation.plan.learningSessionId,
+            roundOrdinal: 0,
+            expectedRevision: 1,
