+      await _rejectUnchanged(h.db, c, () => h.nextId, confirm(owner: h.owner));
+      final acceptedConfirmation = confirm();
+      await c.dispatch(acceptedConfirmation);
+      expect(c.state.attempts.single.role, PairAttemptRole.guidedCompletion);
+      expect(
