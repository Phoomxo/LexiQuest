+
+bool _isCanonicalWordId(String value) =>
+    value.isNotEmpty &&
+    value == value.trim() &&
+    value.runes.length <= 256 &&
+    !value.contains('@') &&
+    !_control.hasMatch(value);
+
+bool _isCanonicalSha256(String? value) =>
+    value != null && _sha256.hasMatch(value);
