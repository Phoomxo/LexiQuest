+
+final class FirestoreDefaultCategoryStore implements DefaultCategoryStore {
+  FirestoreDefaultCategoryStore({FirebaseFirestore? firestore})
+    : _firestore = firestore ?? FirebaseFirestore.instance;
+
+  final FirebaseFirestore _firestore;
+
+  @override
+  Future<void> ensureCategory({
+    required String id,
+    required String name,
+    required String uid,
+  }) async {
+    final reference = _firestore.collection('categories').doc(id);
+    await _firestore.runTransaction((transaction) async {
+      final existing = await transaction.get(reference);
+      if (!existing.exists) {
+        transaction.set(reference, {
+          'category_name': name,
+          'created_at': Timestamp.now(),
+          'uid': uid,
+        });
+      }
+    });
+  }
+
+  @override
+  Future<void> ensureWord({
+    required String categoryId,
+    required String id,
+    required String uid,
+    required String word,
+    required String meaning,
+    required String partOfSpeech,
+  }) async {
+    final reference = _firestore
+        .collection('categories')
+        .doc(categoryId)
+        .collection('words')
+        .doc(id);
+    await _firestore.runTransaction((transaction) async {
+      final existing = await transaction.get(reference);
+      if (!existing.exists) {
+        transaction.set(reference, {
+          'word': word,
+          'meaning': meaning,
+          'part_of_speech': partOfSpeech,
+          'user_id': uid,
+          'is_global': false,
+          'created_at': Timestamp.now(),
