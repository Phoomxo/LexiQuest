+      unawaited(
+        handoff.then<void>(
+          (_) => _ownerSubscription?.cancel(),
+          onError: (Object _, StackTrace _) => _ownerSubscription?.cancel(),
+        ),
+      );
+    }
+    super.dispose();
+  }
