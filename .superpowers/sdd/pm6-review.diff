+  String pronounce(String languageCode) => switch (languageCode) {
+    'th' => choose('ฟังคำไทย', 'Listen to Thai word'),
+    'en' => choose('ฟังคำอังกฤษ', 'Listen to English word'),
+    _ => choose('ฟังคำ $languageCode', 'Listen to $languageCode word'),
+  };
