diff --git a/tool/cli/tests/android-device-capability-contract.tests.ps1 b/tool/cli/tests/android-device-capability-contract.tests.ps1
new file mode 100644
index 0000000..e8072cc
--- /dev/null
+++ b/tool/cli/tests/android-device-capability-contract.tests.ps1
@@ -0,0 +1,266 @@
+[CmdletBinding()]
+param()
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+$repositoryRoot = (Resolve-Path (Join-Path $PSScriptRoot '..\..\..')).Path
+$gradlePath = Join-Path $repositoryRoot 'android\app\build.gradle.kts'
+$dartPath = Join-Path $repositoryRoot 'lib\device\device_capability_probe.dart'
+$activityPath = Join-Path $repositoryRoot 'android\app\src\main\kotlin\com\lexiquest\app\MainActivity.kt'
+$pluginPath = Join-Path $repositoryRoot 'android\app\src\main\kotlin\com\lexiquest\app\DeviceCapabilityPlugin.kt'
+
+function Read-Source {
+    param([string]$Path)
+    if (Test-Path -LiteralPath $Path -PathType Leaf) {
+        return [System.IO.File]::ReadAllText($Path)
+    }
+    return ''
+}
+
+function Get-DartSnapshotKeys {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string]$Source
+    )
+
+    $setMatch = [regex]::Match(
+        $Source,
+        '(?ms)static\s+const\s+Set<String>\s+_snapshotKeys\s*=\s*<String>\s*\{(?<body>.*?)^\s*\};\r?$'
+    )
+    if (-not $setMatch.Success) {
+        return @()
+    }
+    return @(
+        [regex]::Matches(
+            $setMatch.Groups['body'].Value,
+            "'(?<key>[A-Za-z][A-Za-z0-9]*)'\s*,"
+        ) |
+            ForEach-Object { $_.Groups['key'].Value }
+    )
+}
+
+function Get-KotlinResultMapKeys {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string]$Source
+    )
+
+    $mapMatch = [regex]::Match(
+        $Source,
+        '(?ms)return\s+mapOf<String,\s*Any\?>\s*\((?<body>.*?)^ {8}\)\r?$',
+        [System.Text.RegularExpressions.RegexOptions]::CultureInvariant
+    )
+    if (-not $mapMatch.Success) {
+        return @()
+    }
+    return @(
+        [regex]::Matches(
+            $mapMatch.Groups['body'].Value,
+            '"(?<key>[A-Za-z][A-Za-z0-9]*)"\s+to\s+'
+        ) |
+            ForEach-Object { $_.Groups['key'].Value }
+    )
+}
+
+function Test-SnapshotKeyParity {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string[]]$DartKeys,
+        [Parameter(Mandatory = $true)]
+        [string[]]$KotlinKeys
+    )
+
+    if ($DartKeys.Count -eq 0 -or
+        $DartKeys.Count -ne @($DartKeys | Sort-Object -Unique).Count -or
+        $KotlinKeys.Count -ne @($KotlinKeys | Sort-Object -Unique).Count -or
+        $DartKeys.Count -ne $KotlinKeys.Count) {
+        return $false
+    }
+    return @(
+        Compare-Object $DartKeys $KotlinKeys -CaseSensitive
+    ).Count -eq 0
+}
+
+function Test-KotlinMemoryMappings {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string]$Source
+    )
+
+    return (
+        $Source -match 'ActivityManager\.MemoryInfo\s*\(\s*\)\.also\s*\(\s*activityManager::getMemoryInfo\s*\)' -and
+        $Source -match '"memoryClassMb"\s+to\s+activityManager\.memoryClass(?:\s*,)?'
+    )
+}
+
+$gradle = Read-Source $gradlePath
+$dart = Read-Source $dartPath
+$activity = Read-Source $activityPath
+$plugin = Read-Source $pluginPath
+
+$channelName = 'com.lexiquest.app/device_capabilities'
+$methodName = 'snapshot'
+$dartSnapshotKeys = @(Get-DartSnapshotKeys -Source $dart)
+$pluginMapKeys = @(Get-KotlinResultMapKeys -Source $plugin)
+
+$dartParserDefined =
+    $null -ne (Get-Command Get-DartSnapshotKeys -ErrorAction SilentlyContinue)
+$parityFunctionDefined =
+    $null -ne (Get-Command Test-SnapshotKeyParity -ErrorAction SilentlyContinue)
+$mismatchFixtureRejected = $false
+if ($dartParserDefined -and $parityFunctionDefined) {
+    $mismatchDart = @'
+static const Set<String> _snapshotKeys = <String>{
+  'alpha',
+  'beta',
+};
+'@
+$mismatchKotlin = @'
+return mapOf<String, Any?>(
+    "alpha" to 1,
+    "gamma" to 2,
+        )
+'@
+    $mismatchDartKeys = @(Get-DartSnapshotKeys -Source $mismatchDart)
+    $mismatchKotlinKeys = @(Get-KotlinResultMapKeys -Source $mismatchKotlin)
+    $mismatchFixtureRejected =
+        $mismatchDartKeys.Count -eq 2 -and
+        $mismatchKotlinKeys.Count -eq 2 -and
+        -not (
+        Test-SnapshotKeyParity `
+            -DartKeys $mismatchDartKeys `
+            -KotlinKeys $mismatchKotlinKeys
+        )
+}
+
+$memoryContractDefined =
+    $null -ne (
+        Get-Command Test-KotlinMemoryMappings -ErrorAction SilentlyContinue
+    )
+$missingPopulationFixtureRejected = $false
+$hardCodedMemoryClassFixtureRejected = $false
+if ($memoryContractDefined) {
+    $validMemoryMapping = @'
+val memoryInfo =
+    ActivityManager.MemoryInfo().also(activityManager::getMemoryInfo)
+return mapOf<String, Any?>(
+    "memoryClassMb" to activityManager.memoryClass,
+        )
+'@
+    $missingPopulationCall = @'
+val memoryInfo = ActivityManager.MemoryInfo()
+return mapOf<String, Any?>(
+    "memoryClassMb" to activityManager.memoryClass,
+        )
+'@
+    $hardCodedMemoryClass = @'
+val memoryInfo =
+    ActivityManager.MemoryInfo().also(activityManager::getMemoryInfo)
+return mapOf<String, Any?>(
+    "memoryClassMb" to 512,
+        )
+'@
+    $validMemoryMappingAccepted =
+        Test-KotlinMemoryMappings -Source $validMemoryMapping
+    $missingPopulationFixtureRejected =
+        $validMemoryMappingAccepted -and
+        -not (Test-KotlinMemoryMappings -Source $missingPopulationCall)
+    $hardCodedMemoryClassFixtureRejected =
+        $validMemoryMappingAccepted -and
+        -not (Test-KotlinMemoryMappings -Source $hardCodedMemoryClass)
+}
+
+$checks = [ordered]@{
+    'Contract derives its schema authority from Dart source' =
+        $dartParserDefined
+    'Contract self-test rejects a Dart and Kotlin key mismatch' =
+        $mismatchFixtureRejected
+    'Android minimum SDK is explicitly API 29' =
+        $gradle -match '(?m)^\s*minSdk\s*=\s*29\s*$'
+    'Dart declares the exact capability channel' =
+        ([regex]::Matches($dart, [regex]::Escape("'$channelName'"))).Count -eq 1
+    'Kotlin declares the exact capability channel' =
+        ([regex]::Matches($plugin, [regex]::Escape("""$channelName"""))).Count -eq 1
+    'Dart invokes only the exact snapshot method' =
+        $dart -match "_snapshotMethod\s*=\s*'$methodName'"
+    'Kotlin handles only the exact snapshot method' =
+        $plugin -match "METHOD_SNAPSHOT\s*=\s*""$methodName"""
+    'MainActivity overrides configureFlutterEngine' =
+        $activity -match 'override\s+fun\s+configureFlutterEngine\s*\(\s*flutterEngine:\s*FlutterEngine\s*\)'
+    'MainActivity calls the superclass engine configuration' =
+        ([regex]::Matches(
+            $activity,
+            'super\.configureFlutterEngine\s*\(\s*flutterEngine\s*\)'
+        )).Count -eq 1
+    'MainActivity registers exactly one capability plugin' =
+        ([regex]::Matches(
+            $activity,
+            'flutterEngine\.plugins\.add\s*\(\s*DeviceCapabilityPlugin\s*\(\s*\)\s*\)'
+        )).Count -eq 1
+    'Plugin reads ActivityManager MemoryInfo' =
+        $plugin -match 'ActivityManager\.MemoryInfo\s*\('
+    'Plugin populates MemoryInfo through the exact ActivityManager call' =
+        $plugin -match 'ActivityManager\.MemoryInfo\s*\(\s*\)\.also\s*\(\s*activityManager::getMemoryInfo\s*\)'
+    'Plugin maps memoryClassMb directly from ActivityManager' =
+        $plugin -match '"memoryClassMb"\s+to\s+activityManager\.memoryClass(?:\s*,)?'
+    'Contract self-test rejects unpopulated MemoryInfo construction' =
+        $missingPopulationFixtureRejected
+    'Contract self-test rejects a hard-coded memoryClassMb value' =
+        $hardCodedMemoryClassFixtureRejected
+    'Plugin fails redacted when ActivityManager is unavailable' =
+        $plugin -match '(?ms)as\?\s*ActivityManager\s*\r?\n\s*\?:\s*throw\s+DeviceCapabilityUnavailableException\s*\(' -and
+        $plugin -notmatch 'activityManager\?\.memoryClass\s*\?:\s*0'
+    'Plugin reports native failures with only a stable error code' =
+        $plugin -match 'result\.error\s*\(\s*"capability-unavailable"\s*,\s*null\s*,\s*null\s*\)'
+    'Plugin reads available memory and converts it to whole MiB' =
+        $plugin -match '"availableMemoryMb"\s+to\s+memoryInfo\.availMem\.let\(::bytesToWholeMiB\)' -and
+        $plugin -match 'bytesToWholeMiB\s*\(\s*bytes:\s*Long\s*\):\s*Long\s*=\s*bytes\s*/\s*BYTES_PER_MIB' -and
+        $plugin -match 'BYTES_PER_MIB\s*=\s*1024L\s*\*\s*1024L'
+    'Plugin retains free storage in bytes' =
+        $plugin -match '"freeStorageBytes"\s+to\s+StatFs\s*\(\s*context\.filesDir\.absolutePath\s*\)\.availableBytes' -and
+        $plugin -notmatch '"freeStorageBytes"\s+to[^\r\n]*bytesToWholeMiB'
+    'Plugin reads power-save mode' =
+        $plugin -match '\.isPowerSaveMode\b'
+    'Plugin reads current thermal status' =
+        $plugin -match '\.currentThermalStatus\b'
+    'Plugin reads supported ABI data' =
+        $plugin -match 'Build\.SUPPORTED_ABIS\b'
+    'Plugin reads device configuration GPU API data' =
+        $plugin -match '\.deviceConfigurationInfo\b' -and
+        $plugin -match '\.reqGlEsVersion\b'
+    'Plugin maps every thermal constant to the exact stable name' =
+        $plugin -match 'THERMAL_STATUS_NONE\s*->\s*"nominal"' -and
+        $plugin -match '(?ms)THERMAL_STATUS_LIGHT\s*,\s*\r?\n\s*PowerManager\.THERMAL_STATUS_MODERATE\s*,?\s*\r?\n\s*->\s*"fair"' -and
+        $plugin -match 'THERMAL_STATUS_SEVERE\s*->\s*"serious"' -and
+        $plugin -match '(?ms)THERMAL_STATUS_CRITICAL\s*,\s*\r?\n\s*PowerManager\.THERMAL_STATUS_EMERGENCY\s*,\s*\r?\n\s*PowerManager\.THERMAL_STATUS_SHUTDOWN\s*,?\s*\r?\n\s*->\s*"critical"' -and
+        $plugin -match 'else\s*->\s*"unknown"'
+    'Plugin returns exactly the Dart snapshot keys' =
+        (Test-SnapshotKeyParity `
+            -DartKeys $dartSnapshotKeys `
+            -KotlinKeys $pluginMapKeys)
+    'Plugin does not read device model or manufacturer' =
+        $plugin -notmatch 'Build\.(?:MODEL|MANUFACTURER)\b'
+    'Plugin does not read Android ID or serial identifiers' =
+        $plugin -notmatch '(?:Settings\.Secure\.ANDROID_ID|Build\.(?:SERIAL|getSerial)\b)'
+    'Plugin contains no logging call' =
+        $plugin -notmatch '(?m)\b(?:Log\.[vdiewtf]|println|printStackTrace)\s*\('
+    'Plugin contains no network API' =
+        $plugin -notmatch '\b(?:HttpURLConnection|URLConnection|OkHttpClient|Socket|URL)\b'
+}
+
+$failed = @($checks.GetEnumerator() | Where-Object { -not $_.Value })
+foreach ($check in $checks.GetEnumerator()) {
+    $state = if ($check.Value) { 'PASS' } else { 'FAIL' }
+    Write-Host "$state - $($check.Key)"
+}
+Write-Host (
+    'Android device capability contract: {0} passed, {1} failed' -f
+    ($checks.Count - $failed.Count),
+    $failed.Count
+)
+if ($failed.Count -gt 0) {
+    exit 1
+}
+Write-Host 'PASS'
+exit 0
diff --git a/tool/cli/tests/prototype-production-paths.tests.ps1 b/tool/cli/tests/prototype-production-paths.tests.ps1
new file mode 100644
index 0000000..dbe626f
--- /dev/null
+++ b/tool/cli/tests/prototype-production-paths.tests.ps1
@@ -0,0 +1,515 @@
+[CmdletBinding()]
+param(
+    [switch]$Strict
+)
+
+$ErrorActionPreference = 'Stop'
+Set-StrictMode -Version Latest
+
+$repositoryRoot = (Resolve-Path (Join-Path $PSScriptRoot '..\..\..')).Path
+$inventoryPath = Join-Path $repositoryRoot 'docs\prototype\feature-inventory.md'
+$allowlistPath = Join-Path $repositoryRoot 'tool\cli\prototype-production-paths.allowlist.json'
+
+function ConvertFrom-PrototypeInventoryTable {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string]$Markdown
+    )
+
+    $expectedHeader = 'Feature ID | Visible entry | Screen/route | Current data/device/provider | Offline behavior | Permission/configuration | Truthful unavailable state | Known blocker | Target phase | Evidence'
+    $lines = @([regex]::Split($Markdown, '\r?\n'))
+    $headerIndex = -1
+    for ($index = 0; $index -lt $lines.Count; $index++) {
+        if ($lines[$index].Trim() -eq $expectedHeader) {
+            $headerIndex = $index
+            break
+        }
+    }
+    if ($headerIndex -lt 0 -or $headerIndex + 1 -ge $lines.Count) {
+        throw 'Inventory table header is missing.'
+    }
+
+    $separatorCells = @(
+        $lines[$headerIndex + 1].Split('|') |
+            ForEach-Object { $_.Trim() }
+    )
+    if ($separatorCells.Count -ne 10 -or
+        @($separatorCells | Where-Object { $_ -notmatch '^:?-{3,}:?$' }).Count -gt 0) {
+        throw 'Inventory table separator is malformed.'
+    }
+
+    $rows = [System.Collections.Generic.List[object]]::new()
+    for ($index = $headerIndex + 2; $index -lt $lines.Count; $index++) {
+        $line = $lines[$index]
+        if ([string]::IsNullOrWhiteSpace($line) -or
+            $line.TrimStart().StartsWith('#')) {
+            break
+        }
+
+        $cells = @(
+            $line.Split('|') |
+                ForEach-Object { $_.Trim() }
+        )
+        if ($cells.Count -ne 10) {
+            throw 'Inventory table row is malformed.'
+        }
+
+        $rows.Add(
+            [pscustomobject]@{
+                FeatureId = $cells[0]
+                Evidence = $cells[9]
+            }
+        )
+    }
+    if ($rows.Count -eq 0) {
+        throw 'Inventory table has no feature rows.'
+    }
+
+    return $rows
+}
+
+function Get-PrototypeInventoryCoverageErrors {
+    param(
+        [Parameter(Mandatory = $true)]
+        [object[]]$Rows,
+        [Parameter(Mandatory = $true)]
+        [string[]]$RequiredFeatureIds,
+        [Parameter(Mandatory = $true)]
+        [string[]]$RequiredScreenPaths
+    )
+
+    $featureIds = [System.Collections.Generic.HashSet[string]]::new(
+        [System.StringComparer]::Ordinal
+    )
+    $evidencePaths = [System.Collections.Generic.HashSet[string]]::new(
+        [System.StringComparer]::Ordinal
+    )
+    foreach ($row in $Rows) {
+        [void]$featureIds.Add([string]$row.FeatureId)
+        foreach ($pathMatch in [regex]::Matches(
+            [string]$row.Evidence,
+            '\blib/[A-Za-z0-9_./-]+\.dart\b'
+        )) {
+            [void]$evidencePaths.Add($pathMatch.Value)
+        }
+    }
+
+    $errors = [System.Collections.Generic.List[string]]::new()
+    foreach ($featureId in $RequiredFeatureIds) {
+        if (-not $featureIds.Contains($featureId)) {
+            $errors.Add("Inventory omits allowlisted feature: $featureId")
+        }
+    }
+    foreach ($screenPath in $RequiredScreenPaths) {
+        if (-not $evidencePaths.Contains($screenPath)) {
+            $errors.Add("Inventory omits reachable screen: $screenPath")
+        }
+    }
+
+    return $errors
+}
+
+if (-not (Test-Path -LiteralPath $inventoryPath -PathType Leaf)) {
+    Write-Error 'Prototype feature inventory is missing.'
+    exit 1
+}
+if (-not (Test-Path -LiteralPath $allowlistPath -PathType Leaf)) {
+    Write-Error 'Prototype production-path allowlist is missing.'
+    exit 1
+}
+
+$ruleSpecs = @(
+    [pscustomobject]@{
+        Name = 'sample-user-history'
+        Pattern = '\b(?:sample|mock|fake)(?:User)?(?:History|Progress|Attempts?|Sessions?|Scores?|Metrics?|Stats?)\b|this\.listeningScore\s*=\s*85\.0|widget\.customItems\s*\?\?\s*\[|_ghostSnapshot\s*=\s*GhostSnapshot\s*\('
+        ScreensOnly = $false
+    },
+    [pscustomobject]@{
+        Name = 'mock-production-provider'
+        Pattern = '(?:=|return)\s*(?:const\s+)?Mock[A-Z]\w*(?:Provider|Service|Repository|Gateway)\s*\('
+        ScreensOnly = $false
+    },
+    [pscustomobject]@{
+        Name = 'simulated-device-result'
+        Pattern = '\b(?:simulated|mock)(?:Device|Camera|Speech|Scan|Detection|Recognition|Transcription|Confidence|Result)\w*|object-scanner-simulate-button|_toggleMicListening\s*\(\)\s*\{.*?Future\.delayed.*?_sendMessage\s*\(\s*'''
+        ScreensOnly = $false
+    },
+    [pscustomobject]@{
+        Name = 'random-fabricated-measurement'
+        Pattern = 'Random\s*\(\s*\)\.nextDouble\s*\(\s*\)'
+        ScreensOnly = $false
+    },
+    [pscustomobject]@{
+        Name = 'placeholder-transaction-feature'
+        Pattern = '\bplaceholder\b|\bnot\s+implemented\b'
+        ScreensOnly = $false
+    },
+    [pscustomobject]@{
+        Name = 'canned-ai-response'
+        Pattern = '\b_cannedFallbackReply\s*\('
+        ScreensOnly = $false
+    },
+    [pscustomobject]@{
+        Name = 'direct-screen-firebase-access'
+        Pattern = '(?m)^\s*import\s+''package:(?:cloud_firestore|firebase_[^/''"]+)/'
+        ScreensOnly = $true
+    },
+    [pscustomobject]@{
+        Name = 'direct-screen-http-access'
+        Pattern = '(?m)^\s*import\s+''package:http/'
+        ScreensOnly = $true
+    },
+    [pscustomobject]@{
+        Name = 'direct-screen-plugin-access'
+        Pattern = '(?m)^\s*import\s+''package:(?:speech_to_text|shared_preferences|image_picker|camera|google_mlkit[^/''"]*|flutter_tts|audioplayers|file_picker|permission_handler)/'
+        ScreensOnly = $true
+    }
+)
+
+$directScreenPluginRule = @(
+    $ruleSpecs |
+        Where-Object Name -eq 'direct-screen-plugin-access'
+)
+$sharedPreferencesProbe = @'
+import 'package:shared_preferences/shared_preferences.dart';
+'@
+$sharedPreferencesProbeCount = [regex]::Matches(
+    $sharedPreferencesProbe,
+    $directScreenPluginRule[0].Pattern,
+    [System.Text.RegularExpressions.RegexOptions]::IgnoreCase -bor
+        [System.Text.RegularExpressions.RegexOptions]::Singleline
+).Count
+if ($directScreenPluginRule.Count -ne 1 -or
+    $sharedPreferencesProbeCount -ne 1) {
+    Write-Error 'Rule self-test failed: SharedPreferences screen import.'
+    exit 1
+}
+
+$knownRuleNames = @{}
+foreach ($ruleSpec in $ruleSpecs) {
+    $knownRuleNames[$ruleSpec.Name] = $true
+}
+
+$validationErrors = [System.Collections.Generic.List[string]]::new()
+
+try {
+    $allowlistText = [System.IO.File]::ReadAllText($allowlistPath)
+    $allowlist = $allowlistText | ConvertFrom-Json
+}
+catch {
+    Write-Error 'Allowlist JSON is malformed.'
+    exit 1
+}
+
+$allowlistPropertyNames = @(
+    if ($null -ne $allowlist) {
+        $allowlist.PSObject.Properties.Name
+    }
+)
+$parsedSchemaVersion = 0
+if ($null -eq $allowlist -or
+    -not ($allowlistPropertyNames -contains 'schemaVersion') -or
+    -not [int]::TryParse(
+        [string]$allowlist.schemaVersion,
+        [ref]$parsedSchemaVersion
+    ) -or
+    $parsedSchemaVersion -ne 1) {
+    $validationErrors.Add('Allowlist schemaVersion must equal 1.')
+}
+if ($null -eq $allowlist -or
+    -not ($allowlistPropertyNames -contains 'entries') -or
+    $null -eq $allowlist.entries) {
+    $validationErrors.Add('Allowlist entries must be present.')
+    $allowlistEntries = @()
+}
+else {
+    $allowlistEntries = @($allowlist.entries)
+}
+
+$allowByKey = @{}
+foreach ($entry in $allowlistEntries) {
+    $entryPropertyNames = @(
+        if ($null -ne $entry) {
+            $entry.PSObject.Properties.Name
+        }
+    )
+    $requiredEntryProperties = @(
+        'path',
+        'rule',
+        'targetPhase',
+        'featureId'
+    )
+    $missingEntryProperties = @(
+        $requiredEntryProperties |
+            Where-Object { -not ($entryPropertyNames -contains $_) }
+    )
+    if ($null -eq $entry -or $missingEntryProperties.Count -gt 0) {
+        $validationErrors.Add('Allowlist entry is missing required fields.')
+        continue
+    }
+
+    $path = [string]$entry.path
+    $rule = [string]$entry.rule
+    $featureId = [string]$entry.featureId
+    $targetPhase = 0
+    $phaseIsValid = [int]::TryParse(
+        [string]$entry.targetPhase,
+        [ref]$targetPhase
+    )
+
+    if ([string]::IsNullOrWhiteSpace($path) -or
+        [System.IO.Path]::IsPathRooted($path) -or
+        $path.Contains('\') -or
+        $path.Contains('..') -or
+        -not $path.StartsWith('lib/')) {
+        $validationErrors.Add('Allowlist entry has an invalid relative path.')
+        continue
+    }
+    if (-not $knownRuleNames.ContainsKey($rule)) {
+        $validationErrors.Add("Allowlist entry has unknown rule: $rule")
+        continue
+    }
+    if (-not $phaseIsValid -or $targetPhase -lt 1 -or $targetPhase -gt 10) {
+        $validationErrors.Add("Allowlist entry has invalid target phase: $path")
+    }
+    if ([string]::IsNullOrWhiteSpace($featureId)) {
+        $validationErrors.Add("Allowlist entry has no feature ID: $path")
+    }
+
+    $absolutePath = Join-Path $repositoryRoot ($path.Replace('/', '\'))
+    if (-not (Test-Path -LiteralPath $absolutePath -PathType Leaf)) {
+        $validationErrors.Add("Allowlist entry names a missing file: $path")
+    }
+
+    $key = "$path::$rule"
+    if ($allowByKey.ContainsKey($key)) {
+        $validationErrors.Add("Duplicate allowlist pair: $path / $rule")
+    }
+    else {
+        $allowByKey[$key] = [pscustomobject]@{
+            Path = $path
+            Rule = $rule
+            FeatureId = $featureId
+            TargetPhase = $targetPhase
+        }
+    }
+}
+
+Push-Location $repositoryRoot
+try {
+    $candidatePaths = @(
+        & git ls-files -- 'lib/' |
+            Where-Object { $_ -match '\.dart$' } |
+            Sort-Object -Unique
+    )
+    if ($LASTEXITCODE -ne 0) {
+        Write-Error 'git ls-files failed for the bounded lib/ scan.'
+        exit 1
+    }
+}
+finally {
+    Pop-Location
+}
+
+$findingsByKey = @{}
+$regexOptions = [System.Text.RegularExpressions.RegexOptions]::IgnoreCase -bor
+    [System.Text.RegularExpressions.RegexOptions]::Singleline
+
+foreach ($relativePath in $candidatePaths) {
+    $absolutePath = Join-Path $repositoryRoot ($relativePath.Replace('/', '\'))
+    $content = [System.IO.File]::ReadAllText($absolutePath)
+
+    foreach ($ruleSpec in $ruleSpecs) {
+        if ($ruleSpec.ScreensOnly -and
+            -not $relativePath.StartsWith('lib/screens/')) {
+            continue
+        }
+
+        $matchCount = [regex]::Matches(
+            $content,
+            $ruleSpec.Pattern,
+            $regexOptions
+        ).Count
+        if ($matchCount -eq 0) {
+            continue
+        }
+
+        $key = "$relativePath::$($ruleSpec.Name)"
+        $findingsByKey[$key] = [pscustomobject]@{
+            Path = $relativePath
+            Rule = $ruleSpec.Name
+            Count = $matchCount
+        }
+    }
+}
+
+foreach ($findingKey in $findingsByKey.Keys) {
+    if (-not $allowByKey.ContainsKey($findingKey)) {
+        $finding = $findingsByKey[$findingKey]
+        $validationErrors.Add(
+            "New finding: $($finding.Path) / $($finding.Rule) / targetPhase=unassigned / count=$($finding.Count)"
+        )
+    }
+}
+foreach ($allowKey in $allowByKey.Keys) {
+    if (-not $findingsByKey.ContainsKey($allowKey)) {
+        $entry = $allowByKey[$allowKey]
+        $validationErrors.Add(
+            "Stale entry: $($entry.Path) / $($entry.Rule) / targetPhase=$($entry.TargetPhase) / count=0"
+        )
+    }
+}
+
+$inventoryCoverageProbe = @'
+# Probe
+
+Prose mentions prose.only and lib/screens/prose_only.dart.
+
+Feature ID | Visible entry | Screen/route | Current data/device/provider | Offline behavior | Permission/configuration | Truthful unavailable state | Known blocker | Target phase | Evidence
+--- | --- | --- | --- | --- | --- | --- | --- | --- | ---
+actual.row | Actual | Direct route | Local | Works | None | Empty | ready | 2 | `lib/screens/actual_row.dart`
+'@
+$inventoryCoverageProbeRows = @(
+    ConvertFrom-PrototypeInventoryTable -Markdown $inventoryCoverageProbe
+)
+$proseOnlyCoverageErrors = @(
+    Get-PrototypeInventoryCoverageErrors `
+        -Rows $inventoryCoverageProbeRows `
+        -RequiredFeatureIds @('prose.only') `
+        -RequiredScreenPaths @('lib/screens/prose_only.dart')
+)
+$actualRowCoverageErrors = @(
+    Get-PrototypeInventoryCoverageErrors `
+        -Rows $inventoryCoverageProbeRows `
+        -RequiredFeatureIds @('actual.row') `
+        -RequiredScreenPaths @('lib/screens/actual_row.dart')
+)
+if ($proseOnlyCoverageErrors.Count -ne 2 -or
+    $actualRowCoverageErrors.Count -ne 0) {
+    Write-Error 'Inventory table coverage self-test failed.'
+    exit 1
+}
+
+$reachableScreenPaths = @(
+    'lib/screens/session_gate_screen.dart',
+    'lib/screens/login_screen.dart',
+    'lib/screens/register_screen.dart',
+    'lib/screens/otp_screen.dart',
+    'lib/screens/forgot_password_screen.dart',
+    'lib/screens/reset_password_screen.dart',
+    'lib/screens/change_password_screen.dart',
+    'lib/screens/main_navigation_screen.dart',
+    'lib/screens/choose_mode_screen.dart',
+    'lib/screens/mastery_dashboard_screen.dart',
+    'lib/screens/weakness_clinic_screen.dart',
+    'lib/screens/achievements_screen.dart',
+    'lib/screens/profile_settings_screen.dart',
+    'lib/screens/categories_page.dart',
+    'lib/screens/shop_page.dart',
+    'lib/screens/setting_screen.dart',
+    'lib/screens/cefr_selection_screen.dart',
+    'lib/screens/cefr_diagnostic_test_screen.dart',
+    'lib/screens/dictation_quiz_screen.dart',
+    'lib/screens/shadowing_challenge_screen.dart',
+    'lib/screens/sentence_scramble_screen.dart',
+    'lib/screens/srs_flashcards_screen.dart',
+    'lib/screens/smart_audio_playlist_screen.dart',
+    'lib/screens/cefr_article_reader_screen.dart',
+    'lib/screens/boss_battle_screen.dart',
+    'lib/screens/ghost_shadow_duel_screen.dart',
+    'lib/screens/interactive_storybook_screen.dart',
+    'lib/screens/wordbook_import_screen.dart',
+    'lib/screens/export_center_screen.dart',
+    'lib/screens/phonetic_explorer_screen.dart',
+    'lib/screens/avatar_equipment_screen.dart',
+    'lib/screens/ai_tutor_screen.dart',
+    'lib/screens/learning_world_map_screen.dart',
+    'lib/screens/quiz_screen.dart',
+    'lib/screens/select_category_for_quiz.dart',
+    'lib/screens/score_screen.dart',
+    'lib/screens/speak_to_text_screen.dart',
+    'lib/screens/word_scramble_screen.dart',
+    'lib/screens/fill_in_the_blanks_screen.dart',
+    'lib/screens/vocab_list_screen.dart',
+    'lib/screens/add_vocab_screen.dart',
+    'lib/screens/add_multiple_words_screen.dart',
+    'lib/screens/select_wallpaper_screen.dart'
+)
+
+$inventory = [System.IO.File]::ReadAllText($inventoryPath)
+try {
+    $inventoryRows = @(
+        ConvertFrom-PrototypeInventoryTable -Markdown $inventory
+    )
+}
+catch {
+    $validationErrors.Add('Inventory table is malformed.')
+    $inventoryRows = @()
+}
+
+$requiredFeatureIds = @(
+    $allowByKey.Values |
+        ForEach-Object FeatureId |
+        Sort-Object -Unique
+)
+$inventoryCoverageErrors = @(
+    Get-PrototypeInventoryCoverageErrors `
+        -Rows $inventoryRows `
+        -RequiredFeatureIds $requiredFeatureIds `
+        -RequiredScreenPaths $reachableScreenPaths
+)
+foreach ($inventoryCoverageError in $inventoryCoverageErrors) {
+    $validationErrors.Add($inventoryCoverageError)
+}
+
+$duplicateInventoryFeatureIds = @(
+    $inventoryRows |
+        Group-Object FeatureId |
+        Where-Object Count -gt 1
+)
+foreach ($duplicateInventoryFeatureId in $duplicateInventoryFeatureIds) {
+    if (-not [string]::IsNullOrWhiteSpace($duplicateInventoryFeatureId.Name)) {
+        $validationErrors.Add(
+            "Inventory has duplicate feature ID: $($duplicateInventoryFeatureId.Name)"
+        )
+    }
+}
+
+if ($validationErrors.Count -gt 0) {
+    foreach ($validationError in $validationErrors) {
+        Write-Error $validationError
+    }
+    exit 1
+}
+
+$sortedFindings = @(
+    $findingsByKey.Values |
+        Sort-Object Path, Rule
+)
+$totalMatchCount = 0
+foreach ($finding in $sortedFindings) {
+    $entry = $allowByKey["$($finding.Path)::$($finding.Rule)"]
+    $totalMatchCount += $finding.Count
+    Write-Output (
+        'path={0} rule={1} targetPhase={2} count={3}' -f
+        $finding.Path,
+        $finding.Rule,
+        $entry.TargetPhase,
+        $finding.Count
+    )
+}
+
+$knownDebtCount = $sortedFindings.Count
+Write-Output (
+    'summary candidateFiles={0} knownDebt={1} matches={2} new=0 stale=0' -f
+    $candidatePaths.Count,
+    $knownDebtCount,
+    $totalMatchCount
+)
+
+if ($Strict -and $knownDebtCount -gt 0) {
+    Write-Error "Strict mode: knownDebt=$knownDebtCount"
+    exit 1
+}
+
+exit 0
