diff --git a/lib/device/device_capability_models.dart b/lib/device/device_capability_models.dart
new file mode 100644
index 0000000..9736198
--- /dev/null
+++ b/lib/device/device_capability_models.dart
@@ -0,0 +1,270 @@
+/// Coarse capability bands used by the on-device inference policy.
+enum DevicePerformanceTier { lite, balanced, enhanced }
+
+/// Normalized thermal states that are safe to carry across platform boundaries.
+enum DeviceThermalState {
+  nominal,
+  fair,
+  serious,
+  critical,
+  unknown;
+
+  /// Converts Android's numeric thermal status to the safe internal taxonomy.
+  static DeviceThermalState fromNativeValue(int value) {
+    switch (value) {
+      case 0:
+        return DeviceThermalState.nominal;
+      case 1:
+      case 2:
+        return DeviceThermalState.fair;
+      case 3:
+        return DeviceThermalState.serious;
+      case 4:
+      case 5:
+      case 6:
+        return DeviceThermalState.critical;
+      default:
+        return DeviceThermalState.unknown;
+    }
+  }
+
+  /// Alias retained for platform adapters that use the shorter conversion name.
+  static DeviceThermalState fromNative(int value) => fromNativeValue(value);
+}
+
+enum InferenceBackend { xnnpackCpu, gpuDelegate }
+
+/// Caller-asserted provenance metadata; it is not proof of hardware execution.
+enum InferenceBenchmarkProvenance { assertedOnDeviceInferenceAdapter }
+
+/// Closed, privacy-safe reason codes produced by [InferencePolicy].
+enum InferenceDecisionReason {
+  cpuBenchmarkDegraded('cpu-benchmark-degraded'),
+  sdkUnsupported('sdk-unsupported'),
+  capabilityEvidenceMissing('capability-evidence-missing'),
+  batterySaver('battery-saver'),
+  thermalConstrained('thermal-constrained'),
+  lowMemory('low-memory'),
+  availableMemoryConstrained('available-memory-constrained'),
+  storageConstrained('storage-constrained'),
+  balancedMemory('balanced-memory'),
+  storageNotEnhanced('storage-not-enhanced'),
+  gpuNotCandidate('gpu-not-candidate'),
+  gpuBenchmarkMissing('gpu-benchmark-missing'),
+  gpuBenchmarkFailed('gpu-benchmark-failed'),
+  gpuEvidenceMismatch('gpu-evidence-mismatch'),
+  gpuEvidenceProvenanceMissing('gpu-evidence-provenance-missing'),
+  gpuSlowerThanCpu('gpu-slower-than-cpu'),
+  gpuBenchmarkQualified('gpu-benchmark-qualified');
+
+  const InferenceDecisionReason(this.code);
+
+  final String code;
+}
+
+/// An immutable, privacy-safe view of the capability signals used by policy.
+class DeviceCapabilitySnapshot {
+  factory DeviceCapabilitySnapshot({
+    required int sdkInt,
+    required String primaryAbi,
+    required int memoryClassMb,
+    required int? availableMemoryMb,
+    required int? freeStorageBytes,
+    required bool? lowMemory,
+    required bool? batterySaverEnabled,
+    required DeviceThermalState thermalState,
+    required bool? gpuApiCandidate,
+  }) {
+    final normalizedAbi = primaryAbi.trim().toLowerCase();
+    if (normalizedAbi.isEmpty) {
+      throw ArgumentError.value(primaryAbi, 'primaryAbi', 'must not be empty');
+    }
+    if (memoryClassMb < 0 ||
+        (availableMemoryMb != null && availableMemoryMb < 0) ||
+        (freeStorageBytes != null && freeStorageBytes < 0)) {
+      throw ArgumentError('memory and storage values must not be negative');
+    }
+
+    return DeviceCapabilitySnapshot._(
+      sdkInt: sdkInt,
+      primaryAbi: normalizedAbi,
+      memoryClassMb: memoryClassMb,
+      availableMemoryMb: availableMemoryMb,
+      freeStorageBytes: freeStorageBytes,
+      lowMemory: lowMemory,
+      batterySaverEnabled: batterySaverEnabled,
+      thermalState: thermalState,
+      gpuApiCandidate: gpuApiCandidate,
+    );
+  }
+
+  const DeviceCapabilitySnapshot._({
+    required this.sdkInt,
+    required this.primaryAbi,
+    required this.memoryClassMb,
+    required this.availableMemoryMb,
+    required this.freeStorageBytes,
+    required this.lowMemory,
+    required this.batterySaverEnabled,
+    required this.thermalState,
+    required this.gpuApiCandidate,
+  });
+
+  final int sdkInt;
+  final String primaryAbi;
+  final int memoryClassMb;
+  final int? availableMemoryMb;
+  final int? freeStorageBytes;
+  final bool? lowMemory;
+  final bool? batterySaverEnabled;
+  final DeviceThermalState thermalState;
+  final bool? gpuApiCandidate;
+
+  bool get isSupported => sdkInt >= 29;
+
+  bool get hasRequiredPolicyEvidence =>
+      availableMemoryMb != null &&
+      freeStorageBytes != null &&
+      lowMemory != null &&
+      batterySaverEnabled != null &&
+      gpuApiCandidate != null;
+
+  @override
+  String toString() => 'DeviceCapabilitySnapshot';
+}
+
+/// Result of a bounded benchmark for one inference backend.
+///
+/// Model identity and provenance are asserted metadata supplied by the caller.
+/// This value object and the pure policy can verify internal consistency only;
+/// they cannot prove that a backend ran or that a model was loaded. Production
+/// adapter construction and loaded-model SHA validation are required later
+/// inference-adapter integration work.
+class InferenceBenchmark {
+  factory InferenceBenchmark({
+    required InferenceBackend backend,
+    required bool successful,
+    int? medianLatencyMicros,
+    required int completedRuns,
+    String? failureCode,
+    required String modelId,
+    required String modelVersion,
+    required String modelSha256,
+    required InferenceBenchmarkProvenance? provenance,
+  }) {
+    final normalizedModelId = modelId.trim().toLowerCase();
+    final normalizedModelVersion = modelVersion.trim();
+    final normalizedModelSha256 = modelSha256.trim().toLowerCase();
+    if (normalizedModelId.isEmpty ||
+        !_semanticVersionPattern.hasMatch(normalizedModelVersion)) {
+      throw ArgumentError('model identity values are invalid');
+    }
+    if (!_sha256Pattern.hasMatch(normalizedModelSha256)) {
+      throw ArgumentError.value(
+        modelSha256,
+        'modelSha256',
+        'must be a 64-character hexadecimal SHA-256 fingerprint',
+      );
+    }
+    if (completedRuns < 0 ||
+        completedRuns > maximumCompletedRuns ||
+        (medianLatencyMicros != null &&
+            (medianLatencyMicros < 0 ||
+                medianLatencyMicros > maximumMedianLatencyMicros))) {
+      throw ArgumentError('benchmark values are outside safe bounds');
+    }
+    if (successful &&
+        (medianLatencyMicros == null ||
+            medianLatencyMicros == 0 ||
+            completedRuns == 0 ||
+            failureCode != null)) {
+      throw ArgumentError(
+        'successful benchmarks require completed measurements',
+      );
+    }
+    if (!successful &&
+        (failureCode == null || !_stableFailureCodes.contains(failureCode))) {
+      throw ArgumentError.value(failureCode, 'failureCode', 'is not stable');
+    }
+
+    return InferenceBenchmark._(
+      backend: backend,
+      successful: successful,
+      medianLatencyMicros: medianLatencyMicros,
+      completedRuns: completedRuns,
+      failureCode: failureCode,
+      modelId: normalizedModelId,
+      modelVersion: normalizedModelVersion,
+      modelSha256: normalizedModelSha256,
+      provenance: provenance,
+    );
+  }
+
+  const InferenceBenchmark._({
+    required this.backend,
+    required this.successful,
+    required this.medianLatencyMicros,
+    required this.completedRuns,
+    required this.failureCode,
+    required this.modelId,
+    required this.modelVersion,
+    required this.modelSha256,
+    required this.provenance,
+  });
+
+  static const int maximumMedianLatencyMicros = 60000000;
+  static const int maximumCompletedRuns = 10000;
+  static const Set<String> _stableFailureCodes = {
+    'delegate-unavailable',
+    'delegate-init-failed',
+    'model-unsupported',
+    'benchmark-failed',
+    'benchmark-missing',
+  };
+  static final RegExp _sha256Pattern = RegExp(r'^[a-f0-9]{64}$');
+  // Supported form is canonical SemVer core only: MAJOR.MINOR.PATCH.
+  static final RegExp _semanticVersionPattern = RegExp(
+    r'^(?:0|[1-9]\d*)\.(?:0|[1-9]\d*)\.(?:0|[1-9]\d*)$',
+  );
+
+  final InferenceBackend backend;
+  final bool successful;
+  final int? medianLatencyMicros;
+  final int completedRuns;
+  final String? failureCode;
+  final String modelId;
+  final String modelVersion;
+  final String modelSha256;
+  final InferenceBenchmarkProvenance? provenance;
+
+  bool hasSameModelAs(InferenceBenchmark other) =>
+      modelId == other.modelId &&
+      modelVersion == other.modelVersion &&
+      modelSha256 == other.modelSha256;
+
+  @override
+  String toString() =>
+      'InferenceBenchmark(backend: ${backend.name}, failureCode: $failureCode)';
+}
+
+/// The single safe configuration selected for a snapshot and its evidence.
+class InferenceDecision {
+  const InferenceDecision({
+    required this.tier,
+    required this.backend,
+    required this.analysisFrequency,
+    required this.reason,
+  });
+
+  final DevicePerformanceTier tier;
+  final InferenceBackend backend;
+  final String analysisFrequency;
+  final InferenceDecisionReason reason;
+
+  String get reasonCode => reason.code;
+
+  @override
+  String toString() =>
+      'InferenceDecision(tier: ${tier.name}, backend: ${backend.name}, '
+      'reasonCode: ${reason.code})';
+}
diff --git a/lib/device/device_capability_probe.dart b/lib/device/device_capability_probe.dart
new file mode 100644
index 0000000..9927a11
--- /dev/null
+++ b/lib/device/device_capability_probe.dart
@@ -0,0 +1,122 @@
+import 'package:flutter/foundation.dart';
+import 'package:flutter/services.dart';
+
+import 'device_capability_models.dart';
+
+abstract interface class DeviceCapabilityProbe {
+  Future<DeviceCapabilitySnapshot> snapshot();
+}
+
+final class MethodChannelDeviceCapabilityProbe
+    implements DeviceCapabilityProbe {
+  const MethodChannelDeviceCapabilityProbe();
+
+  static const MethodChannel _channel = MethodChannel(
+    'com.lexiquest.app/device_capabilities',
+  );
+  static const String _snapshotMethod = 'snapshot';
+  static const Set<String> _snapshotKeys = <String>{
+    'sdkInt',
+    'primaryAbi',
+    'memoryClassMb',
+    'availableMemoryMb',
+    'freeStorageBytes',
+    'lowMemory',
+    'batterySaverEnabled',
+    'thermalState',
+    'gpuApiCandidate',
+  };
+
+  @override
+  Future<DeviceCapabilitySnapshot> snapshot() async {
+    if (kIsWeb || defaultTargetPlatform != TargetPlatform.android) {
+      throw const DeviceCapabilityUnavailable('unsupported-platform');
+    }
+
+    final Object? payload;
+    try {
+      payload = await _channel.invokeMethod<Object?>(_snapshotMethod);
+    } on MissingPluginException {
+      throw const DeviceCapabilityUnavailable('channel-unavailable');
+    } on PlatformException {
+      throw const DeviceCapabilityUnavailable('channel-unavailable');
+    } on Object {
+      throw const DeviceCapabilityUnavailable('channel-unavailable');
+    }
+
+    try {
+      final snapshot = _parseSnapshot(payload);
+      if (!snapshot.isSupported) {
+        throw const DeviceCapabilityUnavailable('android-version-unsupported');
+      }
+      return snapshot;
+    } on DeviceCapabilityUnavailable {
+      rethrow;
+    } on Object {
+      throw const DeviceCapabilityUnavailable('malformed-snapshot');
+    }
+  }
+
+  DeviceCapabilitySnapshot _parseSnapshot(Object? payload) {
+    if (payload is! Map<Object?, Object?> ||
+        payload.length != _snapshotKeys.length ||
+        payload.keys.any((key) => key is! String) ||
+        !payload.keys.cast<String>().toSet().containsAll(_snapshotKeys)) {
+      throw const DeviceCapabilityUnavailable('malformed-snapshot');
+    }
+
+    final sdkInt = payload['sdkInt'];
+    final primaryAbi = payload['primaryAbi'];
+    final memoryClassMb = payload['memoryClassMb'];
+    final availableMemoryMb = payload['availableMemoryMb'];
+    final freeStorageBytes = payload['freeStorageBytes'];
+    final lowMemory = payload['lowMemory'];
+    final batterySaverEnabled = payload['batterySaverEnabled'];
+    final thermalState = payload['thermalState'];
+    final gpuApiCandidate = payload['gpuApiCandidate'];
+
+    if (sdkInt is! int ||
+        primaryAbi is! String ||
+        memoryClassMb is! int ||
+        !_isNullable<int>(availableMemoryMb) ||
+        !_isNullable<int>(freeStorageBytes) ||
+        !_isNullable<bool>(lowMemory) ||
+        !_isNullable<bool>(batterySaverEnabled) ||
+        thermalState is! String ||
+        !_isNullable<bool>(gpuApiCandidate)) {
+      throw const DeviceCapabilityUnavailable('malformed-snapshot');
+    }
+
+    final normalizedThermalState = switch (thermalState) {
+      'nominal' => DeviceThermalState.nominal,
+      'fair' => DeviceThermalState.fair,
+      'serious' => DeviceThermalState.serious,
+      'critical' => DeviceThermalState.critical,
+      'unknown' => DeviceThermalState.unknown,
+      _ => throw const DeviceCapabilityUnavailable('malformed-snapshot'),
+    };
+
+    return DeviceCapabilitySnapshot(
+      sdkInt: sdkInt,
+      primaryAbi: primaryAbi,
+      memoryClassMb: memoryClassMb,
+      availableMemoryMb: availableMemoryMb as int?,
+      freeStorageBytes: freeStorageBytes as int?,
+      lowMemory: lowMemory as bool?,
+      batterySaverEnabled: batterySaverEnabled as bool?,
+      thermalState: normalizedThermalState,
+      gpuApiCandidate: gpuApiCandidate as bool?,
+    );
+  }
+
+  bool _isNullable<T>(Object? value) => value == null || value is T;
+}
+
+final class DeviceCapabilityUnavailable implements Exception {
+  const DeviceCapabilityUnavailable(this.code);
+
+  final String code;
+
+  @override
+  String toString() => 'DeviceCapabilityUnavailable($code)';
+}
diff --git a/lib/device/inference_policy.dart b/lib/device/inference_policy.dart
new file mode 100644
index 0000000..df49552
--- /dev/null
+++ b/lib/device/inference_policy.dart
@@ -0,0 +1,108 @@
+import 'device_capability_models.dart';
+
+/// Deterministically selects the safest available inference configuration.
+///
+/// This pure policy checks asserted evidence metadata for consistency. It does
+/// not initialize XNNPACK or a GPU delegate, prove hardware execution, or
+/// validate a loaded model's SHA-256; those are later adapter integration work.
+class InferencePolicy {
+  InferencePolicy._();
+
+  static const int _minimumAvailableMemoryMb = 768;
+  static const int _enhancedAvailableMemoryMb = 2048;
+  static const int _minimumFreeStorageBytes = 512 * 1024 * 1024;
+  static const int _enhancedFreeStorageBytes = 1024 * 1024 * 1024;
+
+  static InferenceDecision select(
+    DeviceCapabilitySnapshot snapshot,
+    InferenceBenchmark cpuBenchmark, [
+    InferenceBenchmark? gpuBenchmark,
+  ]) {
+    if (!snapshot.hasRequiredPolicyEvidence) {
+      return _lite(InferenceDecisionReason.capabilityEvidenceMissing);
+    }
+    if (cpuBenchmark.backend != InferenceBackend.xnnpackCpu ||
+        !cpuBenchmark.successful) {
+      return _lite(InferenceDecisionReason.cpuBenchmarkDegraded);
+    }
+    if (!snapshot.isSupported) {
+      return _lite(InferenceDecisionReason.sdkUnsupported);
+    }
+    if (snapshot.batterySaverEnabled!) {
+      return _lite(InferenceDecisionReason.batterySaver);
+    }
+    if (_isThermallyConstrained(snapshot.thermalState)) {
+      return _lite(InferenceDecisionReason.thermalConstrained);
+    }
+    if (snapshot.lowMemory!) {
+      return _lite(InferenceDecisionReason.lowMemory);
+    }
+    if (snapshot.availableMemoryMb! < _minimumAvailableMemoryMb) {
+      return _lite(InferenceDecisionReason.availableMemoryConstrained);
+    }
+    if (snapshot.freeStorageBytes! < _minimumFreeStorageBytes) {
+      return _lite(InferenceDecisionReason.storageConstrained);
+    }
+    if (snapshot.availableMemoryMb! < _enhancedAvailableMemoryMb) {
+      return _balanced(InferenceDecisionReason.balancedMemory);
+    }
+    if (snapshot.freeStorageBytes! < _enhancedFreeStorageBytes) {
+      return _balanced(InferenceDecisionReason.storageNotEnhanced);
+    }
+    if (!snapshot.gpuApiCandidate!) {
+      return _balanced(InferenceDecisionReason.gpuNotCandidate);
+    }
+    if (gpuBenchmark == null) {
+      return _balanced(InferenceDecisionReason.gpuBenchmarkMissing);
+    }
+    if (gpuBenchmark.backend != InferenceBackend.gpuDelegate ||
+        !gpuBenchmark.successful) {
+      return _balanced(InferenceDecisionReason.gpuBenchmarkFailed);
+    }
+    if (cpuBenchmark.provenance !=
+            InferenceBenchmarkProvenance.assertedOnDeviceInferenceAdapter ||
+        gpuBenchmark.provenance !=
+            InferenceBenchmarkProvenance.assertedOnDeviceInferenceAdapter) {
+      return _balanced(InferenceDecisionReason.gpuEvidenceProvenanceMissing);
+    }
+    if (!cpuBenchmark.hasSameModelAs(gpuBenchmark)) {
+      return _balanced(InferenceDecisionReason.gpuEvidenceMismatch);
+    }
+
+    final cpuLatency = cpuBenchmark.medianLatencyMicros!;
+    final gpuLatency = gpuBenchmark.medianLatencyMicros!;
+    final latencyDifference = gpuLatency - cpuLatency;
+    // Benchmark bounds cap this multiplication below 600,000,000 microseconds.
+    if (latencyDifference > 0 && latencyDifference * 10 > cpuLatency) {
+      return _balanced(InferenceDecisionReason.gpuSlowerThanCpu);
+    }
+
+    return const InferenceDecision(
+      tier: DevicePerformanceTier.enhanced,
+      backend: InferenceBackend.gpuDelegate,
+      analysisFrequency: 'enhanced',
+      reason: InferenceDecisionReason.gpuBenchmarkQualified,
+    );
+  }
+
+  static bool _isThermallyConstrained(DeviceThermalState state) =>
+      state == DeviceThermalState.serious ||
+      state == DeviceThermalState.critical ||
+      state == DeviceThermalState.unknown;
+
+  static InferenceDecision _lite(InferenceDecisionReason reason) =>
+      InferenceDecision(
+        tier: DevicePerformanceTier.lite,
+        backend: InferenceBackend.xnnpackCpu,
+        analysisFrequency: 'low',
+        reason: reason,
+      );
+
+  static InferenceDecision _balanced(InferenceDecisionReason reason) =>
+      InferenceDecision(
+        tier: DevicePerformanceTier.balanced,
+        backend: InferenceBackend.xnnpackCpu,
+        analysisFrequency: 'standard',
+        reason: reason,
+      );
+}
