+import 'package:flutter_test/flutter_test.dart';
+import 'package:vocab_learning_app/device/device_capability_models.dart';
+
+void main() {
+  DeviceCapabilitySnapshot supportedSnapshot({
+    int sdkInt = 29,
+    String primaryAbi = '  ARM64-V8A  ',
+    int memoryClassMb = 256,
+    int availableMemoryMb = 2048,
+    int freeStorageBytes = 1024 * 1024 * 1024,
+    bool lowMemory = false,
+    bool batterySaverEnabled = false,
+    DeviceThermalState thermalState = DeviceThermalState.nominal,
+    bool gpuApiCandidate = true,
+  }) {
+    return DeviceCapabilitySnapshot(
+      sdkInt: sdkInt,
+      primaryAbi: primaryAbi,
+      memoryClassMb: memoryClassMb,
+      availableMemoryMb: availableMemoryMb,
+      freeStorageBytes: freeStorageBytes,
+      lowMemory: lowMemory,
+      batterySaverEnabled: batterySaverEnabled,
+      thermalState: thermalState,
+      gpuApiCandidate: gpuApiCandidate,
+    );
+  }
+
+  test('marks snapshots below SDK 29 as unsupported', () {
+    final snapshot = supportedSnapshot(sdkInt: 28);
+
+    expect(snapshot.isSupported, isFalse);
+  });
+
+  test('normalizes a primary ABI to one non-empty value', () {
+    final snapshot = supportedSnapshot(primaryAbi: '  ARM64-V8A  ');
+
+    expect(snapshot.primaryAbi, 'arm64-v8a');
+    expect(() => supportedSnapshot(primaryAbi: '   '), throwsArgumentError);
+  });
+
+  test('rejects negative memory and storage values', () {
+    expect(() => supportedSnapshot(memoryClassMb: -1), throwsArgumentError);
+    expect(() => supportedSnapshot(availableMemoryMb: -1), throwsArgumentError);
+    expect(() => supportedSnapshot(freeStorageBytes: -1), throwsArgumentError);
+  });
+
+  test('maps unknown native thermal values to unknown', () {
+    expect(DeviceThermalState.fromNativeValue(-1), DeviceThermalState.unknown);
+    expect(DeviceThermalState.fromNativeValue(99), DeviceThermalState.unknown);
+  });
+
+  test('rejects unstable benchmark failure codes', () {
+    expect(
+      () => InferenceBenchmark(
+        backend: InferenceBackend.gpuDelegate,
+        successful: false,
+        completedRuns: 0,
+        failureCode: 'raw-platform-error',
+      ),
+      throwsArgumentError,
+    );
+  });
+
+  test('string representations exclude raw hardware values', () {
+    final snapshot = supportedSnapshot(
+      primaryAbi: 'device-secret-abi',
+      memoryClassMb: 513,
+      availableMemoryMb: 2053,
+      freeStorageBytes: 123456789,
+    );
+    final benchmark = InferenceBenchmark(
+      backend: InferenceBackend.xnnpackCpu,
+      successful: false,
+      completedRuns: 0,
+      failureCode: 'benchmark-failed',
+    );
+    const decision = InferenceDecision(
+      tier: DevicePerformanceTier.balanced,
+      backend: InferenceBackend.xnnpackCpu,
+      analysisFrequency: 'standard',
+      reasonCode: 'gpu-benchmark-missing',
+    );
+
+    final output = '$snapshot $benchmark $decision';
+
+    expect(output, isNot(contains('device-secret-abi')));
+    expect(output, isNot(contains('2053')));
+    expect(output, isNot(contains('123456789')));
+    expect(output, contains('DeviceCapabilitySnapshot'));
+    expect(output, contains('xnnpackCpu'));
+    expect(output, contains('balanced'));
+    expect(output, contains('gpu-benchmark-missing'));
+  });
+}
diff --git a/test/device/inference_policy_test.dart b/test/device/inference_policy_test.dart
new file mode 100644
index 0000000..09b731a
--- /dev/null
+++ b/test/device/inference_policy_test.dart
@@ -0,0 +1,182 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:vocab_learning_app/device/device_capability_models.dart';
+import 'package:vocab_learning_app/device/inference_policy.dart';
+
+void main() {
+  DeviceCapabilitySnapshot snapshot({
+    int sdkInt = 29,
+    int availableMemoryMb = 4096,
+    int freeStorageBytes = 2 * 1024 * 1024 * 1024,
+    bool lowMemory = false,
+    bool batterySaverEnabled = false,
+    DeviceThermalState thermalState = DeviceThermalState.nominal,
+    bool gpuApiCandidate = true,
+  }) {
+    return DeviceCapabilitySnapshot(
+      sdkInt: sdkInt,
+      primaryAbi: 'arm64-v8a',
+      memoryClassMb: 256,
+      availableMemoryMb: availableMemoryMb,
+      freeStorageBytes: freeStorageBytes,
+      lowMemory: lowMemory,
+      batterySaverEnabled: batterySaverEnabled,
+      thermalState: thermalState,
+      gpuApiCandidate: gpuApiCandidate,
+    );
+  }
+
+  InferenceBenchmark cpu({bool successful = true, int latencyMicros = 10000}) {
+    return InferenceBenchmark(
+      backend: InferenceBackend.xnnpackCpu,
+      successful: successful,
+      medianLatencyMicros: successful ? latencyMicros : null,
+      completedRuns: successful ? 5 : 0,
+      failureCode: successful ? null : 'benchmark-failed',
+    );
+  }
+
+  InferenceBenchmark gpu({bool successful = true, int latencyMicros = 9000}) {
+    return InferenceBenchmark(
+      backend: InferenceBackend.gpuDelegate,
+      successful: successful,
+      medianLatencyMicros: successful ? latencyMicros : null,
+      completedRuns: successful ? 5 : 0,
+      failureCode: successful ? null : 'delegate-init-failed',
+    );
+  }
+
+  test('uses CPU when the GPU benchmark is missing', () {
+    final decision = InferencePolicy.select(snapshot(), cpu());
+
+    expect(decision.backend, InferenceBackend.xnnpackCpu);
+    expect(decision.tier, DevicePerformanceTier.balanced);
+    expect(decision.reasonCode, 'gpu-benchmark-missing');
+  });
+
+  test(
+    'uses CPU when a GPU API candidate has no successful delegate benchmark',
+    () {
+      final decision = InferencePolicy.select(
+        snapshot(),
+        cpu(),
+        gpu(successful: false),
+      );
+
+      expect(decision.backend, InferenceBackend.xnnpackCpu);
+      expect(decision.reasonCode, 'gpu-benchmark-failed');
+    },
+  );
+
+  test('uses GPU for an enhanced candidate with successful evidence', () {
+    final decision = InferencePolicy.select(snapshot(), cpu(), gpu());
+
+    expect(decision.tier, DevicePerformanceTier.enhanced);
+    expect(decision.backend, InferenceBackend.gpuDelegate);
+    expect(decision.analysisFrequency, 'enhanced');
+    expect(decision.reasonCode, 'gpu-benchmark-qualified');
+  });
+
+  test(
+    'uses CPU when GPU latency is more than ten percent slower than CPU',
+    () {
+      final decision = InferencePolicy.select(
+        snapshot(),
+        cpu(),
+        gpu(latencyMicros: 11001),
+      );
+
+      expect(decision.backend, InferenceBackend.xnnpackCpu);
+      expect(decision.reasonCode, 'gpu-slower-than-cpu');
+    },
+  );
+
+  test('uses Lite CPU in Battery Saver mode', () {
+    final decision = InferencePolicy.select(
+      snapshot(batterySaverEnabled: true),
+      cpu(),
+      gpu(),
+    );
+
+    expect(decision.tier, DevicePerformanceTier.lite);
+    expect(decision.backend, InferenceBackend.xnnpackCpu);
+    expect(decision.analysisFrequency, 'low');
+    expect(decision.reasonCode, 'battery-saver');
+  });
+
+  test('uses Lite CPU for serious, critical, and unknown thermal states', () {
+    for (final thermalState in const [
+      DeviceThermalState.serious,
+      DeviceThermalState.critical,
+      DeviceThermalState.unknown,
+    ]) {
+      final decision = InferencePolicy.select(
+        snapshot(thermalState: thermalState),
+        cpu(),
+        gpu(),
+      );
+
+      expect(decision.tier, DevicePerformanceTier.lite);
+      expect(decision.backend, InferenceBackend.xnnpackCpu);
+      expect(decision.reasonCode, 'thermal-constrained');
+    }
+  });
+
+  test('uses Lite CPU for low-memory signals and storage below 512 MB', () {
+    final lowMemory = InferencePolicy.select(
+      snapshot(lowMemory: true),
+      cpu(),
+      gpu(),
+    );
+    final lowAvailableMemory = InferencePolicy.select(
+      snapshot(availableMemoryMb: 767),
+      cpu(),
+      gpu(),
+    );
+    final lowStorage = InferencePolicy.select(
+      snapshot(freeStorageBytes: 511 * 1024 * 1024),
+      cpu(),
+      gpu(),
+    );
+
+    expect(lowMemory.tier, DevicePerformanceTier.lite);
+    expect(lowAvailableMemory.tier, DevicePerformanceTier.lite);
+    expect(lowStorage.tier, DevicePerformanceTier.lite);
+    expect(lowStorage.reasonCode, 'storage-constrained');
+  });
+
+  test('uses Balanced CPU with 768 to 2047 MB of available memory', () {
+    final decision = InferencePolicy.select(
+      snapshot(availableMemoryMb: 768),
+      cpu(),
+      gpu(),
+    );
+
+    expect(decision.tier, DevicePerformanceTier.balanced);
+    expect(decision.backend, InferenceBackend.xnnpackCpu);
+    expect(decision.analysisFrequency, 'standard');
+    expect(decision.reasonCode, 'balanced-memory');
+  });
+
+  test('requires successful GPU evidence before an enhanced decision', () {
+    final decision = InferencePolicy.select(
+      snapshot(availableMemoryMb: 2048, freeStorageBytes: 1024 * 1024 * 1024),
+      cpu(),
+    );
+
+    expect(decision.tier, DevicePerformanceTier.balanced);
+    expect(decision.backend, InferenceBackend.xnnpackCpu);
+  });
+
+  test('returns degraded CPU when the CPU benchmark is unsuccessful', () {
+    final decision = InferencePolicy.select(
+      snapshot(),
+      cpu(successful: false),
+      gpu(),
+    );
+
+    expect(decision.tier, DevicePerformanceTier.lite);
+    expect(decision.backend, InferenceBackend.xnnpackCpu);
+    expect(decision.analysisFrequency, 'low');
+    expect(decision.reasonCode, 'cpu-benchmark-degraded');
+  });
+}
