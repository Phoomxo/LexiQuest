+      await c.dispatch(prompt);
+      final answer = _tile(c, 'synthetic-0', PairTileSide.target);
+      await _rejectUnchanged(
+        h.db,
+        c,
+        () => h.nextId,
+        _tileCopy(answer, owner: h.owner),
