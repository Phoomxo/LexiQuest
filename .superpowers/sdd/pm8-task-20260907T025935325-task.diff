+  protocolVersion: '1',
+  protocolLimitsIdentity:
+      (const SessionConfigurationProtocolLimits.standard()).contentIdentity,
+  pairDensityPreference: PairDensityPreference(
+    density: density,
+    provenance: PairDensityProvenance.learner,
