+        6,
+        (i) => PairLexicalItem(
+          wordId: '${'w' * 255}$i',
+          contentRevision: 1,
+          checksum: 'f' * 64,
+          spelling: '${'e' * 255}$i',
+          meaning: '${'ก' * 255}$i',
+          sourceLocale: 'en',
