+            reasons.contains(PairPauseReason.clockFault)
+      ? 1
+      : 0;
+  PairTimerState copy({
+    PairTimerMode? mode,
+    int? remainingActiveMs,
+    int? elapsedActiveMs,
+    bool? extensionUsed,
+    Set<PairPauseReason>? reasons,
