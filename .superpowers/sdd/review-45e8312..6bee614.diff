+    },
+    {
+      "path": "lib/screens/main_vocabulary.dart",
+      "rule": "direct-screen-firebase-access",
+      "targetPhase": 2,
+      "featureId": "admin.main-vocabulary-seed"
+    },
+    {
+      "path": "lib/screens/quiz_screen.dart",
+      "rule": "direct-screen-firebase-access",
+      "targetPhase": 2,
+      "featureId": "practice.quiz"
+    },
+    {
+      "path": "lib/screens/select_category_for_quiz.dart",
+      "rule": "direct-screen-firebase-access",
+      "targetPhase": 2,
+      "featureId": "library.category-quiz"
+    },
+    {
+      "path": "lib/screens/select_wallpaper_screen.dart",
+      "rule": "direct-screen-firebase-access",
+      "targetPhase": 5,
+      "featureId": "economy.wallpaper"
+    },
+    {
+      "path": "lib/screens/add_vocab_screen.dart",
+      "rule": "direct-screen-http-access",
+      "targetPhase": 2,
+      "featureId": "library.add-word"
+    },
+    {
+      "path": "lib/screens/speak_to_text_screen.dart",
