+    final transcript = <String, Object?>{
+      'requests': requests,
+      'durableSnapshot': snapshot.toJson(),
+      'answers': (await f.h.db.select(f.h.db.answerAttempts).get())
+          .map((r) => r.toJson())
+          .toList(),
+      'session': (await f.h.db.select(f.h.db.learningSessions).get())
+          .map((r) => r.toJson())
