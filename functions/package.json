{
  "name": "lexiquest-functions",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test lib/progress_writer.test.js",
    "test:emulator": "npm run build && node --test lib/firestore_emulator.test.js",
    "catalog:apply": "npm run build && node lib/product_catalog_cli.js apply",
    "catalog:rollback": "npm run build && node lib/product_catalog_cli.js rollback"
  },
  "dependencies": {
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "glob": "13.0.6",
    "minimatch": "10.2.6",
    "rimraf": "6.1.3",
    "uuid": "11.1.1"
  }
}
